#!/usr/bin/env bash

validate_namespace() {
    [[ $# == 6 ]] || return 2
    [[ $2 == ubuntu && $3 == 26.04 ]] || return 2
    case "$1" in
        container) [[ $4 == 1 ]] || return 2 ;;
        github-hosted) [[ $4 == 0 && $5 == github-hosted && $6 == true ]] || return 2 ;;
        *) return 2 ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    set -euo pipefail
    ID='' VERSION_ID=''
    [[ ! -r /etc/os-release ]] || source /etc/os-release
    docker_marker=0
    [[ ! -f /.dockerenv ]] || docker_marker=1
    if ! validate_namespace "${1:-}" "$ID" "$VERSION_ID" "$docker_marker" "${RUNNER_ENVIRONMENT:-}" "${GITHUB_ACTIONS:-}"; then
        echo 'ci-setup: requires explicit disposable Ubuntu 26.04 container or GitHub-hosted VM mode' >&2
        exit 2
    fi
    [[ $# == 2 && $2 == /* ]] || { echo 'usage: ci-setup {container|github-hosted} ABSOLUTE_STATE_DIR' >&2; exit 2; }
    setup_root=$(cd "$(dirname "$0")/.." && pwd -P)
    mkdir -p "$2/evidence" "$2/setup-home"
    apt_prefix=()
    [[ $(id -u) == 0 ]] || apt_prefix=(sudo -n)
    if [[ $1 == container ]]; then
        printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
        chmod +x /usr/sbin/policy-rc.d
    fi
    "${apt_prefix[@]}" env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="$2/setup-home" DEBIAN_FRONTEND=noninteractive apt-get update
    "${apt_prefix[@]}" env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="$2/setup-home" DEBIAN_FRONTEND=noninteractive \
        apt-get install --no-install-recommends -y python3=3.14.3-0ubuntu2 ca-certificates=20260816ubuntu0.26.04.1
    env -i PATH=/usr/bin:/bin HOME="$2/setup-home" USER="$(id -un)" LANG=C.UTF-8 \
        CI_STATE_DIR="$2" CI_NAMESPACE="$1" SOURCE_ROOT="$setup_root" BUILD_JOBS="${BUILD_JOBS:-2}" \
        PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'
import gzip
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import tempfile
import urllib.request

root = Path(os.environ['SOURCE_ROOT'])
state = Path(os.environ['CI_STATE_DIR']).resolve()
namespace = os.environ['CI_NAMESPACE']
pins = json.loads((root / 'tools/ci-pins.json').read_text())
assert pins['os']['id'] == 'ubuntu' and pins['os']['version'] == '26.04'
assert platform.machine() == 'x86_64'
assert state != root and not state.is_relative_to(root)
evidence = state / 'evidence'
tools = state / 'tools'
for name in ['home', 'config', 'data', 'cache', 'state', 'runtime', 'tools', 'downloads', 'setup-evidence']:
    (state / name).mkdir()
(tools / 'bin').mkdir()
env = {
    'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': str(state / 'home'), 'USER': os.environ['USER'],
    'TERM': 'xterm-256color', 'LANG': 'C.UTF-8', 'TMPDIR': tempfile.mkdtemp(prefix='dt-', dir='/tmp'),
    'XDG_CONFIG_HOME': str(state / 'config'), 'XDG_DATA_HOME': str(state / 'data'),
    'XDG_CACHE_HOME': str(state / 'cache'), 'XDG_STATE_HOME': str(state / 'state'),
    'XDG_RUNTIME_DIR': str(state / 'runtime'), 'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_CONFIG_NOSYSTEM': '1',
    'GIT_TERMINAL_PROMPT': '0', 'GIT_AUTHOR_NAME': 'Fixture', 'GIT_AUTHOR_EMAIL': 'fixture@example.invalid',
    'GIT_COMMITTER_NAME': 'Fixture', 'GIT_COMMITTER_EMAIL': 'fixture@example.invalid',
    'DOTFILES': str(root), 'UV_PROJECT_ENVIRONMENT': str(root / '.venv'),
    'UV_CACHE_DIR': str(state / 'cache/uv'), 'UV_PYTHON': str(tools / 'python/bin/python3.13'),
    'UV_PYTHON_DOWNLOADS': 'never', 'TT_LOG': str(evidence / 'setup-runs.jsonl'),
    'EVIDENCE_DIR': str(state / 'setup-evidence'), 'TT_FORCE': '1', 'GITHUB_ACTIONS': 'true',
    'PYTHONDONTWRITEBYTECODE': '1', 'BUILD_JOBS': str(min(2, int(os.environ['BUILD_JOBS']))),
    'NVM_DIR': str(state / 'data/nvm'), 'FAST_WORK_DIR': str(state / 'cache/fsh'),
    'DEBIAN_FRONTEND': 'noninteractive',
}
assert int(env['BUILD_JOBS']) > 0


def invoke(argv, *, privileged=False, cwd=root, capture=False):
    print('RUN ' + repr(argv), flush=True)
    command = ['sudo', '-n', 'env', '-i', *(f'{key}={value}' for key, value in env.items()), *argv] if privileged and os.getuid() else argv
    result = subprocess.run(command, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE if capture else None, stderr=subprocess.STDOUT)
    if capture:
        print(result.stdout, flush=True)
    result.check_returncode()
    return result.stdout.strip() if capture else None


def download(item):
    path = state / 'downloads' / item['file']
    with urllib.request.urlopen(item['url'], timeout=120) as response, path.open('wb') as out:
        shutil.copyfileobj(response, out)
    with path.open('rb') as inp:
        assert hashlib.file_digest(inp, 'sha256').hexdigest() == item['sha256'], item['file']
    return path


assert hashlib.sha256((root / 'nvim/lazy-lock.json').read_bytes()).hexdigest() == pins['lazy_lock_sha256']
invoke(['apt-get', 'install', '--no-install-recommends', '-y',
        *(f'{name}={version}' for name, version in pins['packages'].items())], privileged=True)
assert Path(invoke(['git', 'rev-parse', '--show-toplevel'], capture=True)) == root
sha = invoke(['git', 'rev-parse', 'HEAD'], capture=True)
packages = invoke(['dpkg-query', '-W', '-f=${binary:Package}\t${Version}\n'], capture=True)
(evidence / 'packages.tsv').write_text(packages + '\n')
invoke(['pkg-config', '--modversion', 'wireplumber-0.5'])
assert Path('/usr/include/stb/stb_image_resize2.h').is_file()
assert Path('/usr/include/stdint.h').is_file()
if not Path('/usr/bin/fd').exists():
    invoke(['ln', '-s', '/usr/bin/fdfind', '/usr/bin/fd'], privileged=True)
assert Path('/usr/bin/fd').samefile('/usr/bin/fdfind')
for item in pins['downloads']:
    path = download(item)
    if item['name'] == 'tree-sitter':
        target = tools / 'bin/tree-sitter'
        with gzip.open(path, 'rb') as inp, target.open('wb') as out:
            shutil.copyfileobj(inp, out)
        target.chmod(0o755)
    else:
        with tarfile.open(path) as archive:
            archive.extractall(tools, filter='data')
(tools / 'bin/just').symlink_to(tools / 'just')
(tools / 'bin/uv').symlink_to(tools / 'uv-x86_64-unknown-linux-gnu/uv')
(tools / 'bin/opencode').symlink_to(tools / 'opencode')
(tools / 'bin/fastfetch').symlink_to(tools / 'fastfetch-linux-amd64/usr/bin/fastfetch')
node_version = next(row['version'] for row in pins['downloads'] if row['name'] == 'node')
env['PATH'] = f'{tools}/bin:{tools}/python/bin:{tools}/nvim-linux-x86_64/bin:{tools}/node-v{node_version}-linux-x64/bin:/usr/sbin:/usr/bin:/sbin:/bin'
glow_completion = evidence / 'glow-completion.zsh'
glow_completion.write_text(invoke(['glow', 'completion', 'zsh'], capture=True) + '\n')
assert hashlib.sha256(glow_completion.read_bytes()).hexdigest() == pins['glow_completion_sha256']
invoke(['install', '-Dm644', str(glow_completion), '/usr/local/share/zsh/site-functions/_glow'], privileged=True)
git_source = state / 'git-source'
with tarfile.open(download(pins['git'])) as archive:
    archive.extractall(git_source, filter='data')
git_source /= 'git-' + pins['git']['version']
# Hook fixtures resolve Git through /usr/bin rather than the tool PATH.
git_options = ['prefix=/usr', 'NO_GETTEXT=YesPlease', 'NO_TCLTK=YesPlease',
               'NO_EXPAT=YesPlease', 'NO_OPENSSL=YesPlease', 'NO_RUST=YesPlease']
invoke(['make', '-j', env['BUILD_JOBS'], *git_options, 'all'], cwd=git_source)
invoke(['make', *git_options, 'install'], cwd=git_source, privileged=True)
versions = {}
for name, argv in [('python', ['python3', '--version']), ('uv', ['uv', '--version']), ('just', ['just', '--version']),
                   ('nvim', ['nvim', '--version']), ('node', ['node', '--version']),
                   ('tree-sitter', ['tree-sitter', '--version']), ('opencode', ['opencode', '--version']),
                   ('git', ['git', '--version']), ('fastfetch', ['fastfetch', '--version']), ('glow', ['glow', '--version']),
                   ('zsh', ['zsh', '--version']), ('lua', ['lua', '-v']), ('g++', ['g++', '--version'])]:
    versions[name] = invoke(argv, capture=True)
for row in pins['downloads']:
    assert row['version'] in versions[row['name']], row['name']
assert pins['git']['version'] in versions['git']
source = state / 'noctalia'
source.mkdir()
with tarfile.open(download(pins['noctalia'])) as archive:
    archive.extractall(source, filter='data')
source /= 'noctalia-release'
invoke(['meson', 'setup', 'build-release', '--prefix=/usr', '--buildtype=release',
        '-Dnative_optimizations=false', '-Dtests=disabled'], cwd=source)
shutil.copyfile(source / 'build-release/meson-logs/meson-log.txt', evidence / 'meson-configure.log')
invoke(['meson', 'compile', '-C', 'build-release', '-j', env['BUILD_JOBS'], 'noctalia'], cwd=source)
invoke(['meson', 'install', '-C', 'build-release', '--no-rebuild'], cwd=source, privileged=True)
for asset in ['emoji.json', 'fonts/noctalia-tabler.ttf', 'templates/builtin.toml', 'translations/en.json']:
    assert (Path('/usr/share/noctalia/assets') / asset).is_file(), asset
assert '5.4.1' in invoke(['/usr/bin/noctalia', '--version'], capture=True)
assert 'not found' not in invoke(['ldd', '/usr/bin/noctalia'], capture=True)
invoke(['/usr/bin/noctalia', 'completions', 'zsh'])
if namespace == 'container':
    assert os.getuid() == 0
    for path in [root, state, Path(env['TMPDIR'])]:
        invoke(['chown', '-R', '1000:1000', str(path)])
    os.setgroups([])
    os.setgid(1000)
    os.setuid(1000)
env['USER'] = 'dots-ci'
lock = json.loads((root / 'nvim/lazy-lock.json').read_text())
assert set(lock) == {row['name'] for row in pins['plugins'] if row['kind'] == 'nvim'}
destinations = []
for repo in pins['plugins']:
    if repo['kind'] == 'nvim':
        dest = state / 'data/nvim/lazy' / repo['name']
        assert lock[repo['name']]['commit'] == repo['sha']
    elif repo['name'] == 'zdharma-continuum/zinit':
        dest = state / 'data/zinit/zinit.git'
    elif repo['name'] == 'nvm-sh/nvm':
        dest = state / 'data/nvm'
    else:
        dest = state / 'data/zinit/plugins' / repo['name'].replace('/', '---')
    dest.mkdir(parents=True)
    invoke(['git', 'init', '-q', str(dest)])
    assert Path(invoke(['git', '-C', str(dest), 'rev-parse', '--show-toplevel'], capture=True)) == dest
    assert Path(invoke(['git', '-C', str(dest), 'rev-parse', '--absolute-git-dir'], capture=True)) == dest / '.git'
    invoke(['git', '-C', str(dest), 'fetch', '--depth=1', repo['url'], repo['sha']])
    invoke(['git', '-C', str(dest), 'checkout', '--detach', 'FETCH_HEAD'])
    destinations.append((repo, dest))
for row in pins['snippets']:
    target = state / row['cache']
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes((state / row['source']).read_bytes())
    assert hashlib.sha256(target.read_bytes()).hexdigest() == row['sha256']
    (target.parent / '._zinit').mkdir(exist_ok=True)
fsh = state / 'data/zinit/plugins/zdharma-continuum---fast-syntax-highlighting'
Path(env['FAST_WORK_DIR']).mkdir(parents=True)
seed = fsh / 'share/free_theme.zsh'
assert hashlib.sha256(seed.read_bytes()).hexdigest() == pins['fsh_seed_sha256']
shutil.copyfile(seed, Path(env['FAST_WORK_DIR']) / 'secondary_theme.zsh')
(state / 'config/nvim').symlink_to(root / 'nvim')
(state / 'home/.shell').symlink_to(root / 'shell')
(state / 'home/.zshrc').symlink_to(root / 'zshrc')
invoke(['uv', 'sync', '--frozen', '--python', env['UV_PYTHON']])
lua = evidence / 'install-parsers.lua'
lua.write_text('local root = ' + json.dumps(str(root)) + '\nlocal pins = ' +
               'vim.json.decode([==[' + json.dumps(pins['parsers']) + ']==])\n' + '''
vim.opt.rtp:prepend(vim.fn.stdpath('data') .. '/lazy/nvim-treesitter')
local opts
for _, spec in ipairs(dofile(root .. '/nvim/lua/user/plugins/lang.lua')) do
 if spec[1] == 'nvim-treesitter/nvim-treesitter' then opts = spec.opts end
end
assert(opts)
local defs = require('nvim-treesitter.parsers')
for _, pin in ipairs(pins) do
 local info = assert(defs[pin.name]).install_info
 assert(info.url == pin.url and info.location == pin.location)
 assert(info.revision == (pin.declared_revision or pin.revision))
 info.revision = pin.revision
end
local ts = require('nvim-treesitter')
ts.setup({install_dir=opts.install_dir})
assert(ts.install(opts.ensure_installed,{max_jobs=tonumber(vim.env.BUILD_JOBS),summary=true}):wait(900000))
local installed = require('nvim-treesitter.config').get_installed('parsers')
assert(#installed == #pins)
for _, name in ipairs({'ecma','jsx'}) do
 assert(vim.fn.isdirectory(opts.install_dir .. '/queries/' .. name) == 1)
end
vim.opt.rtp:remove(opts.install_dir)
vim.opt.rtp:prepend(opts.install_dir)
for _, pin in ipairs(pins) do
 assert(vim.fn.getfsize(opts.install_dir .. '/parser/' .. pin.name .. '.so') > 0)
 local loaded, err = vim.treesitter.language.add(pin.name)
 assert(loaded,err)
 assert(#vim.treesitter.get_string_parser('',pin.name):parse() > 0)
end
vim.fn.writefile({vim.json.encode(pins)},vim.env.SETUP_PARSERS)
vim.cmd('qa!')
''')
env['SETUP_PARSERS'] = str(evidence / 'parsers.json')
invoke(['nvim', '--headless', '-u', 'NONE', '-l', str(lua)])
del env['SETUP_PARSERS']
guard = state / 'setup-network-guard'
guard.mkdir()
unexpected = evidence / 'setup-unexpected-network.log'
for name in ['curl', 'wget', 'git']:
    target = guard / name
    git_read = ('for arg in "$@"; do case "$arg" in clone|fetch|pull|ls-remote) '
                f'echo "unexpected Git network command" >> "{unexpected}"; exit 99 ;; esac; done\n'
                'exec /usr/bin/git "$@"\n') if name == 'git' else ''
    target.write_text('#!/bin/bash\n' + git_read +
                      f'echo "unexpected download: $0 $*" >> "{unexpected}"\nexit 99\n')
    target.chmod(0o755)
tool_path = env['PATH']
env['PATH'] = str(guard) + ':' + tool_path
invoke(['just', 'test-one', 'zsh', 'tests/dotfiles_check.zsh'])
invoke(['just', 'test-one', 'zsh', 'tests/justfile.zsh'])
assert not unexpected.exists(), 'unqualified runtime download; inspect setup-unexpected-network.log'
assert 'FAST_THEME_NAME="q-jmnemonic"' in (Path(env['FAST_WORK_DIR']) / 'current_theme.zsh').read_text()
assert 'sv-orpledefault' in (Path(env['FAST_WORK_DIR']) / 'secondary_theme.zsh').read_text()
for row in pins['snippets']:
    assert hashlib.sha256((state / row['cache']).read_bytes()).hexdigest() == row['sha256']
for repo, dest in destinations:
    assert invoke(['git', '-C', str(dest), 'rev-parse', 'HEAD'], capture=True) == repo['sha']
    invoke(['git', '-C', str(dest), 'diff', '--exit-code'])
assert hashlib.sha256((root / 'nvim/lazy-lock.json').read_bytes()).hexdigest() == pins['lazy_lock_sha256']
shutil.copyfile(state / 'setup-evidence/phases.jsonl', evidence / 'setup-phases.jsonl')
(evidence / 'plugins.json').write_text(json.dumps(pins['plugins'], indent=2) + '\n')
(evidence / 'snippets.json').write_text(json.dumps(pins['snippets'], indent=2) + '\n')
(evidence / 'tool-versions.json').write_text(json.dumps(versions, indent=2) + '\n')
(evidence / 'namespace.json').write_text(json.dumps({'namespace': namespace, 'os_release': Path('/etc/os-release').read_text(),
    'kernel': platform.release(), 'kernel_scope': 'container shares host kernel' if namespace == 'container' else 'hosted VM kernel',
    'source_sha': sha}, indent=2) + '\n')
env['PATH'] = tool_path
del env['DEBIAN_FRONTEND']
env.update(TT_LOG=str(evidence / 'runs.jsonl'), EVIDENCE_DIR=str(evidence))
(state / 'setup.json').write_text(json.dumps({'namespace': namespace, 'source_sha': sha, 'environment': env}, indent=2) + '\n')
print('Disposable prerequisite setup passed; complete CI verification has not run.', flush=True)
PY
fi
