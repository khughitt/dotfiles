#!/usr/bin/env bash
set -euo pipefail
if (( $# < 2 )); then
    echo "usage: test-one {pytest|zsh|lua|nvim} ARGS..." >&2
    exit 2
fi
runner=$1
shift
case "$runner" in
    pytest) exec uv run --frozen pytest "$@" ;;
    zsh | lua | nvim) exec "$runner" "$@" ;;
    *) echo "test-one: unknown runner: $runner" >&2; exit 2 ;;
esac
