#!/usr/bin/env bash
set -euo pipefail

# Physical path on purpose: ~/d/dotfiles is a symlink spelling of this tree, and
# the checks below compare readlink -f output against DOTS_HOME. Invoked through
# the symlink with a logical pwd, none of those comparisons could ever match.
DOTS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
SKIP_SYSTEMD=false
SKIP_NOCTALIA_IPC=false

# shellcheck source=lib/dotfiles-setup-data.bash
source "${DOTS_HOME}/lib/dotfiles-setup-data.bash"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-systemd)
            SKIP_SYSTEMD=true
            shift
            ;;
        --skip-noctalia-ipc)
            SKIP_NOCTALIA_IPC=true
            shift
            ;;
        --help)
            cat <<'EOF'
Usage: dotfiles-health [--skip-systemd] [--skip-noctalia-ipc]

Check key dotfiles symlinks, required commands, shell sourceability, and user timers.
--skip-noctalia-ipc skips live Noctalia plugin enablement only.
EOF
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
done

failures=0
warnings=0

pass() {
    echo "[OK] $*"
}

warn() {
    echo "[WARN] $*" >&2
    warnings=$((warnings + 1))
}

fail() {
    echo "[FAIL] $*" >&2
    failures=$((failures + 1))
}

check_command() {
    local cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        pass "command found: $cmd"
    else
        fail "missing command: $cmd"
    fi
}

check_optional_command() {
    local cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        pass "optional command found: $cmd"
    else
        warn "optional command missing: $cmd"
    fi
}

check_link() {
    local dest="$1"
    local expected="$2"

    if [[ ! -L "$dest" ]]; then
        fail "not a symlink: $dest"
        return
    fi

    if [[ ! -e "$dest" ]]; then
        fail "broken link: $dest -> $(readlink "$dest"), expected $expected"
        return
    fi

    local actual
    actual="$(readlink "$dest")"
    if [[ "$actual" == "$expected" ]]; then
        pass "link: $dest -> $expected"
    elif [[ "$(realpath "$dest")" == "$(realpath "$expected")" ]]; then
        pass "link: $dest -> $actual"
    else
        fail "wrong link target: $dest -> $actual, expected $expected"
    fi
}

check_link_target() {
    local dest="$1"
    local expected="$2"
    if [[ ! -L "$dest" ]]; then
        fail "not a symlink: $dest"
        return
    fi

    local actual target
    actual="$(readlink "$dest")"
    if [[ "$actual" == /* ]]; then
        target="$actual"
    else
        target="$(dirname "$dest")/$actual"
    fi
    if python3 -c 'import os, sys; raise SystemExit(os.path.realpath(sys.argv[1]) != os.path.realpath(sys.argv[2]))' \
            "$target" "$expected"; then
        pass "link target: $dest -> $(readlink "$dest")"
    else
        fail "wrong link target: $dest -> $actual, expected $expected"
    fi
}

check_config_link() {
    local name="$1"
    check_link "${XDG_CONFIG_HOME}/${name}" "${DOTS_HOME}/${name}"
}

check_absent_stale_config_link() {
    local name="$1"
    local dest="${XDG_CONFIG_HOME}/${name}"

    if [[ -L "$dest" ]]; then
        fail "stale managed config link: $dest"
    elif [[ -e "$dest" ]]; then
        warn "config path exists but is no longer managed: $dest"
    else
        pass "stale managed config absent: $dest"
    fi
}

# The dotfiles tree is shared verbatim between machines, so a symlink stored in
# it resolves the same everywhere. A target naming one machine therefore drags
# every other machine onto that machine's config. Per-machine selection belongs
# in XDG_STATE_HOME, which is not shared. See niri/host_specific.sh.
# The symlink check above cannot see this: Noctalia's generated theme output is
# written as file *content* into the shared tree, through the whole-directory
# ~/.config symlinks. Each of these must be a link out to per-machine state, so
# the colours one machine derives never reach the other.
check_noctalia_generated_is_not_in_tree() {
    local entry tree_path resolved offenders=0

    for entry in "${DOTFILES_NOCTALIA_GENERATED[@]}"; do
        tree_path="${DOTS_HOME}/${entry%%:*}"

        if [[ ! -e "$tree_path" && ! -L "$tree_path" ]]; then
            warn "generated theme output is absent: ${entry%%:*} (run setup.sh)"
            continue
        fi
        if [[ ! -L "$tree_path" ]]; then
            fail "generated theme output is a real file in the shared tree: ${entry%%:*}"
            offenders=$((offenders + 1))
            continue
        fi
        resolved="$(readlink -f "$tree_path" 2>/dev/null || true)"
        if [[ "$resolved" == "${DOTS_HOME}/"* ]]; then
            fail "generated theme output resolves back into the shared tree: ${entry%%:*} -> ${resolved}"
            offenders=$((offenders + 1))
        fi
    done

    if [[ "$offenders" -eq 0 ]]; then
        pass "generated theme output is outside the shared tree (${#DOTFILES_NOCTALIA_GENERATED[@]} paths)"
    fi
}

# The leak surface is structural, not enumerable: ~/.config/<name> entries that are
# whole-directory symlinks into this tree hand every file an application writes there
# to the shared tree, and Dropbox carries it to the other machine. So derive the
# surface instead of listing it. Anything the tree does not own is a leak: not tracked
# in git, not a symlink routed back out of the tree, not marked com.dropbox.ignored.
# A warning, not a failure — an uncommitted file under a config directory is also the
# normal state of work in progress, and the named generated outputs above already fail.
check_config_dirs_do_not_leak() {
    local link target relative entry path resolved leaks=0 dirs=0

    for link in "${XDG_CONFIG_HOME}"/*; do
        [[ -L "$link" ]] || continue
        target="$(readlink -f "$link" 2>/dev/null || true)"
        [[ -d "$target" && "$target" == "${DOTS_HOME}/"* ]] || continue
        dirs=$((dirs + 1))
        relative="${target#"${DOTS_HOME}/"}"

        while IFS= read -r entry; do
            path="${DOTS_HOME}/${entry%/}"
            if [[ -L "$path" ]]; then
                resolved="$(readlink -f "$path" 2>/dev/null || true)"
                [[ "$resolved" == "${DOTS_HOME}/"* ]] || continue
            fi
            if command -v attr >/dev/null 2>&1 \
                && [[ "$(attr -q -g com.dropbox.ignored "$path" 2>/dev/null)" == "1" ]]; then
                continue
            fi
            warn "not owned by the tree and syncing to every machine: ${entry} (commit it, route it to XDG_STATE_HOME, or run dropbox_ignore on it)"
            leaks=$((leaks + 1))
        done < <(git -C "${DOTS_HOME}" ls-files --others --directory -- "$relative" 2>/dev/null)
    done

    if [[ "$dirs" -eq 0 ]]; then
        warn "no ~/.config entry links into the shared tree; skipping the leak check"
    elif [[ "$leaks" -eq 0 ]]; then
        pass "no unowned files under the ${dirs} config directories linked into the shared tree"
    fi
}

# The declared per-machine paths must carry the xattr on this machine, or the
# next application write syncs to the other one. Absent directories are only a
# nudge: setup.sh creates them so the mark precedes the first write.
check_declared_dropbox_ignores_applied() {
    local entry path offenders=0

    for entry in "${DOTFILES_DROPBOX_IGNORED[@]}"; do
        path="${DOTS_HOME}/${entry%/}"
        if [[ ! -e "$path" ]]; then
            [[ "$entry" == */ ]] && warn "declared per-machine directory is absent: ${entry} (run setup.sh)"
            continue
        fi
        if [[ "$(attr -q -g com.dropbox.ignored "$path" 2>/dev/null)" == "1" ]]; then
            continue
        fi
        fail "declared per-machine but syncing: ${entry} (run setup.sh)"
        offenders=$((offenders + 1))
    done

    if [[ "$offenders" -eq 0 ]]; then
        pass "declared per-machine paths are marked com.dropbox.ignored (${#DOTFILES_DROPBOX_IGNORED[@]} declared)"
    fi
}

check_no_machine_specific_links() {
    local machines=() dir link target name offenders=0

    for dir in "${DOTS_HOME}"/prism/*/; do
        [[ -d "$dir" ]] || continue
        machines+=("$(basename "$dir")")
    done

    if [[ "${#machines[@]}" -eq 0 ]]; then
        warn "no machines found under ${DOTS_HOME}/prism; skipping shared-tree symlink check"
        return
    fi

    while IFS= read -r link; do
        target="$(readlink "$link")"
        for name in "${machines[@]}"; do
            if [[ "$target" == *"host-${name}"* || "$target" == *"/${name}/"* ]]; then
                fail "machine-specific symlink in the shared tree: ${link#"${DOTS_HOME}/"} -> ${target}"
                offenders=$((offenders + 1))
                break
            fi
        done
    done < <(find "${DOTS_HOME}" \
        \( -name .git -o -name .worktrees -o -name node_modules -o -name .venv \) -prune -o \
        -type l -print)

    if [[ "$offenders" -eq 0 ]]; then
        pass "no machine-specific symlinks in the shared tree (${machines[*]})"
    fi
}

echo "Dotfiles root: $DOTS_HOME"
echo "Home: $HOME"
echo "XDG config: $XDG_CONFIG_HOME"

for cmd in zsh git rg fd python3; do
    check_command "$cmd"
done

for cmd in fzf shellcheck systemd-analyze; do
    check_optional_command "$cmd"
done

if [[ "$(uname)" != "Darwin" ]]; then
    check_command attr
fi

check_link "${HOME}/.bashrc" "${DOTS_HOME}/bashrc"
check_link "${HOME}/.bash_profile" "${DOTS_HOME}/bash_profile"
check_link "${HOME}/.zshrc" "${DOTS_HOME}/zshrc"
check_link "${HOME}/.zshenv" "${DOTS_HOME}/zshenv"
check_link "${HOME}/.shell" "${DOTS_HOME}/shell"
check_link "${HOME}/.gitconfig" "${DOTS_HOME}/git/config"
check_link "${HOME}/.gitignore_global" "${DOTS_HOME}/git/ignore"

if [[ "$(uname)" != "Darwin" ]]; then
    dotfiles_select_common_configs true
else
    dotfiles_select_common_configs false
fi
managed_config_links=("${DOTFILES_SELECTED_COMMON_CONFIGS[@]}")

for config_name in "${managed_config_links[@]}"; do
    check_config_link "$config_name"
done
unset config_name managed_config_links

lsd_config_dir="${XDG_CONFIG_HOME}/lsd"
if [[ -d "$lsd_config_dir" && ! -L "$lsd_config_dir" ]]; then
    pass "real directory: $lsd_config_dir"
else
    fail "not a real directory: $lsd_config_dir"
fi
check_link "$lsd_config_dir/config.yaml" "${DOTS_HOME}/lsd/config.yaml"
unset lsd_config_dir

yazi_config_dir="${XDG_CONFIG_HOME}/yazi"
if [[ -d "$yazi_config_dir" && ! -L "$yazi_config_dir" ]]; then
    pass "real directory: $yazi_config_dir"
else
    fail "not a real directory: $yazi_config_dir"
fi
check_link "$yazi_config_dir/yazi.toml" "${DOTS_HOME}/yazi/yazi.toml"
unset yazi_config_dir

opencode_local="${XDG_CONFIG_HOME}/opencode.local"
if [[ -d "$opencode_local" && ! -L "$opencode_local" ]]; then
    pass "real directory: $opencode_local"
else
    fail "not a real directory: $opencode_local"
fi
check_link "${XDG_CONFIG_HOME}/opencode" "$opencode_local"
check_link "$opencode_local/opencode.json" "${DOTS_HOME}/opencode/opencode.json"
check_link "$opencode_local/tui.json" "${DOTS_HOME}/opencode/tui.json"
check_link_target \
    "$opencode_local/themes/noctalia.json" \
    "${HOME}/.cache/noctalia/nvim-glass/current/opencode-theme.json"
unset opencode_local

if [[ "$(uname)" != "Darwin" ]]; then
    noctalia_config_dir="${XDG_CONFIG_HOME}/noctalia"
    check_link "$noctalia_config_dir/config.toml" "${DOTS_HOME}/noctalia/config.toml"
    check_link "$noctalia_config_dir/templates.toml" "${DOTS_HOME}/noctalia/templates.toml"
    check_link "$noctalia_config_dir/templates" "${DOTS_HOME}/noctalia/templates"
    check_link "$noctalia_config_dir/palettes/Glow.json" "${DOTS_HOME}/noctalia/palettes/Glow.json"

    noctalia_plugin_dir="${XDG_DATA_HOME}/noctalia/plugins"
    check_link "${noctalia_plugin_dir}/wali-panel" \
        "${HOME}/d/wali/integrations/noctalia-plugin"
    check_link "${noctalia_plugin_dir}/prism" \
        "${HOME}/d/prism/integrations/noctalia-plugin"

    for plugin_name in wali-panel prism; do
        if [[ -f "${noctalia_plugin_dir}/${plugin_name}/plugin.toml" && \
              ! -e "${noctalia_plugin_dir}/${plugin_name}/manifest.json" ]]; then
            pass "Noctalia v5 plugin manifest: ${plugin_name}"
        else
            fail "missing or stale Noctalia plugin manifest: ${plugin_name}"
        fi
    done

    if [[ "$SKIP_NOCTALIA_IPC" == "true" ]]; then
        pass "live Noctalia plugin check explicitly skipped"
    elif plugins=$(noctalia msg plugins list 2>&1); then
        if printf '%s\n' "$plugins" | rg -q '^khughitt/wali-panel .* enabled( |$)'; then
            pass "Noctalia plugin enabled: khughitt/wali-panel"
        else
            fail "Noctalia plugin not enabled: khughitt/wali-panel"
        fi
        if printf '%s\n' "$plugins" | rg -q '^khughitt/prism .* enabled( |$)'; then
            pass "Noctalia plugin enabled: khughitt/prism"
        else
            fail "Noctalia plugin not enabled: khughitt/prism"
        fi
    else
        fail "Noctalia plugin listing failed: $plugins"
    fi

    if output=$(noctalia config validate "$noctalia_config_dir" 2>&1); then
        if grep -Eq '(^|[[:space:]])(WARN|ERROR)([[:space:]]|$)' <<<"$output"; then
            fail "Noctalia config warning or error: $output"
        else
            pass "Noctalia config validates without warnings"
        fi
    else
        fail "Noctalia config validation failed: $output"
    fi

    if merged=$(noctalia config export merged); then
        if python3 -c '
import sys, tomllib
expected = tomllib.load(open(sys.argv[1], "rb"))["theme"]["templates"]
actual = tomllib.loads(sys.stdin.read())["theme"]["templates"]
raise SystemExit(any(
    set(actual[key]) != set(expected[key])
    for key in ("builtin_ids", "community_ids")
))
' "${DOTS_HOME}/noctalia/templates.toml" <<<"$merged" 2>/dev/null; then
            pass "merged Noctalia template selection matches tracked registry"
        else
            fail "merged Noctalia template selection differs from tracked registry"
        fi

        # The tracked config turns Noctalia's own rotation off because
        # wali-rotate.timer owns it. Noctalia persists settings over the
        # tracked file, and a persisted true ran both rotators on titan while
        # every link and timer check passed. Nothing is rewritten here.
        rotator=$(python3 -c '
import sys, tomllib
tracked = tomllib.load(open(sys.argv[1], "rb"))["wallpaper"]["automation"]["enabled"]
merged = tomllib.loads(sys.stdin.read())["wallpaper"]["automation"]["enabled"]
print("noctalia" if tracked else ("conflict" if merged else "timer"))
' "${DOTS_HOME}/noctalia/config.toml" <<<"$merged" 2>/dev/null) || rotator="unreadable"
        case "$rotator" in
            timer) pass "wali-rotate.timer owns wallpaper rotation: Noctalia automation is off" ;;
            noctalia) pass "Noctalia owns wallpaper rotation: tracked config enables its automation" ;;
            conflict) fail "competing wallpaper rotators: persisted Noctalia state sets wallpaper.automation.enabled=true over the tracked false while wali-rotate.timer runs; fix it in Noctalia's settings, then re-run" ;;
            *) fail "could not read wallpaper.automation.enabled from the tracked and merged Noctalia config" ;;
        esac
    else
        fail "Noctalia merged config export failed"
    fi

    if templates=$(noctalia theme --list-templates 2>&1); then
        for template_id in glow nvim claude codex lsd fzf fastfetch ohai; do
            if printf '%s\n' "$templates" | rg -q "^[[:space:]]+${template_id}[[:space:]]+user([[:space:]]|$)"; then
                pass "Noctalia user template: $template_id"
            else
                fail "missing Noctalia user template: $template_id"
            fi
        done
    else
        fail "Noctalia template listing failed: $templates"
    fi
    unset noctalia_config_dir noctalia_plugin_dir output plugins merged rotator templates template_id plugin_name
fi

# Hyprland left the tree on 2026-09-09: niri is the only compositor configured here.
check_absent_stale_config_link "hypr"
check_absent_stale_config_link "snakemake"
check_absent_stale_config_link "tealdeer"

if HOME="$HOME" zsh -fc 'source "$HOME/.shell/functions"' >/dev/null 2>&1; then
    pass "shell functions source cleanly"
else
    fail "shell functions do not source cleanly"
fi

if [[ "$(uname)" != "Darwin" ]]; then
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/dropbox-ignore-flux.service" \
        "${DOTS_HOME}/systemd/user/dropbox-ignore-flux.service"
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/dropbox-ignore-flux.timer" \
        "${DOTS_HOME}/systemd/user/dropbox-ignore-flux.timer"
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/wali-rotate.service" \
        "${HOME}/d/wali/systemd/wali-rotate.service"
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/wali-rotate.timer" \
        "${HOME}/d/wali/systemd/wali-rotate.timer"

    for unit in mindful-web.service mindful-backup.service mindful-backup.timer; do
        check_link "${XDG_CONFIG_HOME}/systemd/user/${unit}" "${DOTS_HOME}/systemd/user/${unit}"
    done
    if [[ -e "${HOME}/.local/share/mindful/current" ]]; then
        for wants in graphical-session.target.wants default.target.wants; do
            if [[ -e "${XDG_CONFIG_HOME}/systemd/user/${wants}/mindful-docker.service" || \
                  -L "${XDG_CONFIG_HOME}/systemd/user/${wants}/mindful-docker.service" ]]; then
                fail "mindful-docker.service is still enabled after v6 activation"
            fi
        done
        if [[ "$SKIP_SYSTEMD" != "true" ]] && command -v systemctl >/dev/null 2>&1; then
            if systemctl --user is-active --quiet mindful-docker.service || \
               systemctl --user is-enabled --quiet mindful-docker.service; then
                fail "mindful-docker.service can revive v3 after v6 activation"
            fi
            if runtime_env=$(systemctl --user show mindful-web.service --property=Environment --value); then
                for setting in HOST=localhost PORT=3331 "MINDFUL_HOME=${HOME}/d/thoughts"; do
                    if [[ " $runtime_env " != *" $setting "* ]]; then
                        fail "mindful-web.service lacks canonical setting: $setting"
                    fi
                done
            else
                fail "mindful-web.service environment could not be queried"
            fi
        fi
    fi

    if [[ "$SKIP_SYSTEMD" != "true" ]]; then
        if command -v systemctl >/dev/null 2>&1; then
            for timer in dropbox-ignore-flux.timer wali-rotate.timer; do
                if systemctl --user is-enabled "$timer" >/dev/null 2>&1; then
                    pass "systemd user timer is enabled: $timer"
                else
                    fail "systemd user timer is not enabled: $timer"
                fi

                if systemctl --user list-timers "$timer" --no-pager >/dev/null 2>&1; then
                    pass "systemd user timer is queryable: $timer"
                else
                    warn "systemd user timer could not be queried: $timer"
                fi
            done
            # systemctl enable resolved the unit's symlink when it wrote this
            # link, so is-enabled keeps saying yes after the unit source moves.
            # realpath in check_link accepts either spelling of the live path.
            check_link \
                "${XDG_CONFIG_HOME}/systemd/user/timers.target.wants/wali-rotate.timer" \
                "${HOME}/d/wali/systemd/wali-rotate.timer"
        else
            warn "systemctl is not available"
        fi
    fi
fi

prism_config="${DOTS_HOME}/prism/$(hostname)"
if [[ -e "${XDG_CONFIG_HOME}/prism" || -L "${XDG_CONFIG_HOME}/prism" || \
      -f "${prism_config}/values.yaml" ]]; then
    prism_failures="$failures"
    check_link "${XDG_CONFIG_HOME}/prism" "$prism_config"
    if [[ -d "${XDG_CONFIG_HOME}/prism/contexts" && ! -L "${XDG_CONFIG_HOME}/prism/contexts" ]]; then
        pass "real directory: ${XDG_CONFIG_HOME}/prism/contexts"
    else
        fail "not a real directory: ${XDG_CONFIG_HOME}/prism/contexts"
    fi
    if [[ "$failures" -eq "$prism_failures" ]]; then
        if prism doctor; then
            pass "prism doctor"
        else
            fail "prism doctor failed"
        fi
    fi
fi
unset prism_config prism_failures

wali_config="${DOTS_HOME}/wali/$(hostname)/config.toml"
if [[ -f "$wali_config" || -L "${XDG_CONFIG_HOME}/wali/config.toml" ]]; then
    check_link "${XDG_CONFIG_HOME}/wali/config.toml" "$wali_config"
fi
unset wali_config

check_no_machine_specific_links
check_noctalia_generated_is_not_in_tree
if [[ "$(uname)" != "Darwin" ]]; then
    check_declared_dropbox_ignores_applied
fi
check_config_dirs_do_not_leak

if [[ "$failures" -gt 0 ]]; then
    echo "Health check failed: $failures failure(s), $warnings warning(s)" >&2
    exit 1
fi

echo "Health check passed: $warnings warning(s)"
