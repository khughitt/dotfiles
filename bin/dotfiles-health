#!/usr/bin/env bash
set -euo pipefail

DOTS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
SKIP_SYSTEMD=false
SKIP_NOCTALIA_IPC=false

# shellcheck source=lib/dotfiles-setup-data.bash
source "${DOTS_HOME}/lib/dotfiles-setup-data.bash"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-systemd)
            SKIP_SYSTEMD=true
            shift
            ;;
        --skip-noctalia-ipc)
            SKIP_NOCTALIA_IPC=true
            shift
            ;;
        --help)
            cat <<'EOF'
Usage: dotfiles-health [--skip-systemd] [--skip-noctalia-ipc]

Check key dotfiles symlinks, required commands, shell sourceability, and user timers.
--skip-noctalia-ipc skips live Noctalia plugin enablement only.
EOF
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
done

failures=0
warnings=0

pass() {
    echo "[OK] $*"
}

warn() {
    echo "[WARN] $*" >&2
    warnings=$((warnings + 1))
}

fail() {
    echo "[FAIL] $*" >&2
    failures=$((failures + 1))
}

check_command() {
    local cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        pass "command found: $cmd"
    else
        fail "missing command: $cmd"
    fi
}

check_optional_command() {
    local cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        pass "optional command found: $cmd"
    else
        warn "optional command missing: $cmd"
    fi
}

check_link() {
    local dest="$1"
    local expected="$2"

    if [[ ! -L "$dest" ]]; then
        fail "not a symlink: $dest"
        return
    fi

    if [[ ! -e "$dest" ]]; then
        fail "broken link: $dest -> $(readlink "$dest"), expected $expected"
        return
    fi

    local actual
    actual="$(readlink "$dest")"
    if [[ "$actual" == "$expected" ]]; then
        pass "link: $dest -> $expected"
    elif [[ "$(realpath "$dest")" == "$(realpath "$expected")" ]]; then
        pass "link: $dest -> $actual"
    else
        fail "wrong link target: $dest -> $actual, expected $expected"
    fi
}

check_link_target() {
    local dest="$1"
    local expected="$2"
    if [[ ! -L "$dest" ]]; then
        fail "not a symlink: $dest"
        return
    fi

    local actual target
    actual="$(readlink "$dest")"
    if [[ "$actual" == /* ]]; then
        target="$actual"
    else
        target="$(dirname "$dest")/$actual"
    fi
    if python3 -c 'import os, sys; raise SystemExit(os.path.realpath(sys.argv[1]) != os.path.realpath(sys.argv[2]))' \
            "$target" "$expected"; then
        pass "link target: $dest -> $(readlink "$dest")"
    else
        fail "wrong link target: $dest -> $actual, expected $expected"
    fi
}

check_config_link() {
    local name="$1"
    check_link "${XDG_CONFIG_HOME}/${name}" "${DOTS_HOME}/${name}"
}

check_absent_stale_config_link() {
    local name="$1"
    local dest="${XDG_CONFIG_HOME}/${name}"

    if [[ -L "$dest" ]]; then
        fail "stale managed config link: $dest"
    elif [[ -e "$dest" ]]; then
        warn "config path exists but is no longer managed: $dest"
    else
        pass "stale managed config absent: $dest"
    fi
}

echo "Dotfiles root: $DOTS_HOME"
echo "Home: $HOME"
echo "XDG config: $XDG_CONFIG_HOME"

for cmd in zsh git rg fd; do
    check_command "$cmd"
done

for cmd in fzf shellcheck systemd-analyze; do
    check_optional_command "$cmd"
done

if [[ "$(uname)" != "Darwin" ]]; then
    check_command attr
fi

check_link "${HOME}/.bashrc" "${DOTS_HOME}/bashrc"
check_link "${HOME}/.bash_profile" "${DOTS_HOME}/bash_profile"
check_link "${HOME}/.zshrc" "${DOTS_HOME}/zshrc"
check_link "${HOME}/.zshenv" "${DOTS_HOME}/zshenv"
check_link "${HOME}/.shell" "${DOTS_HOME}/shell"
check_link "${HOME}/.gitconfig" "${DOTS_HOME}/git/config"
check_link "${HOME}/.gitignore_global" "${DOTS_HOME}/git/ignore"

if [[ "$(uname)" != "Darwin" ]]; then
    dotfiles_select_common_configs true
else
    dotfiles_select_common_configs false
fi
managed_config_links=("${DOTFILES_SELECTED_COMMON_CONFIGS[@]}")

for config_name in "${managed_config_links[@]}"; do
    check_config_link "$config_name"
done
unset config_name managed_config_links

opencode_local="${XDG_CONFIG_HOME}/opencode.local"
if [[ -d "$opencode_local" && ! -L "$opencode_local" ]]; then
    pass "real directory: $opencode_local"
else
    fail "not a real directory: $opencode_local"
fi
check_link "${XDG_CONFIG_HOME}/opencode" "$opencode_local"
check_link "$opencode_local/opencode.json" "${DOTS_HOME}/opencode/opencode.json"
check_link "$opencode_local/tui.json" "${DOTS_HOME}/opencode/tui.json"
check_link_target \
    "$opencode_local/themes/noctalia.json" \
    "${HOME}/.cache/noctalia/nvim-glass/current/opencode-theme.json"
unset opencode_local

if [[ "$(uname)" != "Darwin" ]]; then
    noctalia_config_dir="${XDG_CONFIG_HOME}/noctalia"
    check_link "$noctalia_config_dir/config.toml" "${DOTS_HOME}/noctalia/config.toml"
    check_link "$noctalia_config_dir/templates.toml" "${DOTS_HOME}/noctalia/templates.toml"
    check_link "$noctalia_config_dir/templates" "${DOTS_HOME}/noctalia/templates"
    check_link "$noctalia_config_dir/palettes/Glow.json" "${DOTS_HOME}/noctalia/palettes/Glow.json"

    noctalia_plugin_dir="${XDG_DATA_HOME}/noctalia/plugins"
    check_link "${noctalia_plugin_dir}/wali-panel" \
        "${DOTS_HOME}/noctalia/plugins/wali-panel"
    check_link "${noctalia_plugin_dir}/prism" \
        "${HOME}/d/prism/integrations/noctalia-plugin"

    for plugin_name in wali-panel prism; do
        if [[ -f "${noctalia_plugin_dir}/${plugin_name}/plugin.toml" && \
              ! -e "${noctalia_plugin_dir}/${plugin_name}/manifest.json" ]]; then
            pass "Noctalia v5 plugin manifest: ${plugin_name}"
        else
            fail "missing or stale Noctalia plugin manifest: ${plugin_name}"
        fi
    done

    if [[ "$SKIP_NOCTALIA_IPC" == "true" ]]; then
        pass "live Noctalia plugin check explicitly skipped"
    elif plugins=$(noctalia msg plugins list 2>&1); then
        if printf '%s\n' "$plugins" | rg -q '^khughitt/wali-panel .* enabled$'; then
            pass "Noctalia plugin enabled: khughitt/wali-panel"
        else
            fail "Noctalia plugin not enabled: khughitt/wali-panel"
        fi
        if printf '%s\n' "$plugins" | rg -q '^khughitt/prism .* enabled$'; then
            pass "Noctalia plugin enabled: khughitt/prism"
        else
            fail "Noctalia plugin not enabled: khughitt/prism"
        fi
    else
        fail "Noctalia plugin listing failed: $plugins"
    fi

    if output=$(noctalia config validate "$noctalia_config_dir" 2>&1); then
        if grep -Eq '(^|[[:space:]])(WARN|ERROR)([[:space:]]|$)' <<<"$output"; then
            fail "Noctalia config warning or error: $output"
        else
            pass "Noctalia config validates without warnings"
        fi
    else
        fail "Noctalia config validation failed: $output"
    fi

    if templates=$(noctalia theme --list-templates 2>&1); then
        for template_id in glow nvim claude codex ohai; do
            if printf '%s\n' "$templates" | rg -q "^[[:space:]]+${template_id}[[:space:]]+user([[:space:]]|$)"; then
                pass "Noctalia user template: $template_id"
            else
                fail "missing Noctalia user template: $template_id"
            fi
        done
    else
        fail "Noctalia template listing failed: $templates"
    fi
    unset noctalia_config_dir noctalia_plugin_dir output plugins templates template_id plugin_name
fi

check_absent_stale_config_link "snakemake"
check_absent_stale_config_link "tealdeer"

if HOME="$HOME" zsh -fc 'source "$HOME/.shell/functions"' >/dev/null 2>&1; then
    pass "shell functions source cleanly"
else
    fail "shell functions do not source cleanly"
fi

if [[ "$(uname)" != "Darwin" ]]; then
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/dropbox-ignore-flux.service" \
        "${DOTS_HOME}/systemd/user/dropbox-ignore-flux.service"
    check_link \
        "${XDG_CONFIG_HOME}/systemd/user/dropbox-ignore-flux.timer" \
        "${DOTS_HOME}/systemd/user/dropbox-ignore-flux.timer"

    if [[ "$SKIP_SYSTEMD" != "true" ]]; then
        if command -v systemctl >/dev/null 2>&1; then
            if systemctl --user is-enabled dropbox-ignore-flux.timer >/dev/null 2>&1; then
                pass "systemd user timer is enabled"
            else
                fail "systemd user timer is not enabled: dropbox-ignore-flux.timer"
            fi

            if systemctl --user list-timers dropbox-ignore-flux.timer --no-pager >/dev/null 2>&1; then
                pass "systemd user timer is queryable"
            else
                warn "systemd user timer could not be queried"
            fi
        else
            warn "systemctl is not available"
        fi
    fi
fi

prism_config="${DOTS_HOME}/prism/$(hostname)"
if [[ -e "${XDG_CONFIG_HOME}/prism" || -L "${XDG_CONFIG_HOME}/prism" || \
      -f "${prism_config}/values.yaml" ]]; then
    prism_failures="$failures"
    check_link "${XDG_CONFIG_HOME}/prism" "$prism_config"
    check_link_target \
        "${XDG_CONFIG_HOME}/niri/niri-glass.json" \
        "${XDG_STATE_HOME}/prism/generated/niri-glass.json"
    check_link \
        "${XDG_CONFIG_HOME}/quickshell/niri-glass" \
        "${HOME}/d/niri-glass"
    if [[ -e "${XDG_CONFIG_HOME}/quickshell/shell.qml" || \
          -L "${XDG_CONFIG_HOME}/quickshell/shell.qml" ]]; then
        fail "${XDG_CONFIG_HOME}/quickshell/shell.qml disables named Quickshell configs"
    else
        pass "named Quickshell config discovery is enabled"
    fi
    if [[ "$failures" -eq "$prism_failures" ]]; then
        if prism doctor; then
            pass "prism doctor"
        else
            fail "prism doctor failed"
        fi
    fi
fi
unset prism_config prism_failures

if [[ "$failures" -gt 0 ]]; then
    echo "Health check failed: $failures failure(s), $warnings warning(s)" >&2
    exit 1
fi

echo "Health check passed: $warnings warning(s)"
