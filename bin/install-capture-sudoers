#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

if [[ $# != 1 ]]; then
    echo "Usage: sudo $0 USERNAME" >&2
    exit 1
fi
capture_user=$1
if [[ ! "$capture_user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    echo "Invalid username: $capture_user" >&2
    exit 1
fi
if ! id -u -- "$capture_user" >/dev/null; then
    echo "Unknown user: $capture_user" >&2
    exit 1
fi
if [[ $(id -u) != 0 ]]; then
    echo "Run with sudo: sudo $0 $capture_user" >&2
    exit 1
fi

helper=$(dirname -- "$(readlink -f -- "$0")")/gpu-ctl
rule_dir=$(mktemp -d)
trap 'rm -rf -- "$rule_dir"' EXIT
printf '%s ALL=(root) NOPASSWD: /usr/bin/chvt\n' "$capture_user" > "$rule_dir/50-chvt"
printf '%s ALL=(root) NOPASSWD: /usr/bin/tee /sys/class/graphics/fb0/blank\n' "$capture_user" > "$rule_dir/50-fb-blank"
gpu_ctl=/usr/local/sbin/gpu-ctl
# Exactly the helper's writes (fan 45-100); env_reset pinned here because
# libnvidia-ml reads debug variables such as __NVML_DBG_FILE.
{
    printf 'Defaults!%s env_reset\n' "$gpu_ctl"
    printf '%s ALL=(root) NOPASSWD: ' "$capture_user"
    printf '%s persistence on, %s persistence off, %s fan auto, ' "$gpu_ctl" "$gpu_ctl" "$gpu_ctl"
    printf '%s fan 4[5-9], %s fan [5-9][0-9], %s fan 100\n' "$gpu_ctl" "$gpu_ctl" "$gpu_ctl"
} > "$rule_dir/50-gpu-ctl"
rules=(50-chvt 50-fb-blank 50-gpu-ctl)

# Validate every rule before replacing any live one; the helper goes in before
# the rule that grants it.
for rule in "${rules[@]}"; do
    visudo -cf "$rule_dir/$rule"
done
install -C -T -m 0755 -o root -g root "$helper" "$gpu_ctl"
for rule in "${rules[@]}"; do
    install -C -T -m 0440 -o root -g root "$rule_dir/$rule" "/etc/sudoers.d/$rule"
done
