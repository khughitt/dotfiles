#!/usr/bin/env bash
set -euo pipefail

DOTS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
cd "$DOTS_HOME"

bash_files=(
    bashrc
    bash_profile
    setup.sh
    bin/dotfiles-check
    bin/dotfiles-health
    bin/dotfiles-secrets-check
    lib/dotfiles-setup-data.bash
    hypr/host_specific.sh
    hypr/scripts/monitor-handler.sh
    hypr/scripts/monitor-info.sh
    hypr/scripts/restore-wallpaper.sh
    niri/host_specific.sh
    niri/scripts/monitor-handler.sh
    nvim/tests/noctalia/run.sh
)

zsh_files=(
    zshrc
    zshenv
    shell/aliases
    shell/audio
    shell/functions
    shell/functions.d/dropbox.zsh
    shell/fzf
    shell/history
    shell/macos
    shell/tmux
    shell/ubuntu
    shell/vconsole
    shell/vi
    shell/wali
    shell/zoxide
    tests/dropbox_ignore_flux.zsh
    tests/history.zsh
    tests/secrets_check.zsh
    tests/setup_and_health.zsh
    tests/dotfiles_check.zsh
    tests/tmp_cleanup.zsh
    tests/wali.zsh
)

while IFS= read -r file; do
    zsh_files+=("$file")
done < <(find shell -path 'shell/private' -prune -o -path 'shell/local' -prune -o -type f -name '*.zsh' -print | sort)

echo "bash -n"
bash -n "${bash_files[@]}"

echo "shellcheck"
shellcheck -x "${bash_files[@]}"

echo "zsh -n"
zsh -n "${zsh_files[@]}"

echo "zsh modelines"
if rg -n 'vi:syntax=(bash|zsh)' shell --glob '!private/**' --glob '!local/**'; then
    echo "shell files are zsh-sourced; use vi:filetype=zsh modelines" >&2
    exit 1
fi

# noctalia glass invariant: kitty's generated transparent list must equal the
# six chrome tones in the promoted nvim palette. Fails on partial/desynced
# state; passes on fresh machines. See bin/noctalia-glass-check.
bin/noctalia-glass-check

echo "dotfiles checks passed"
