#!/usr/bin/env bash
set -euo pipefail
# A wrapper rather than a symlink, like bin/prism: a relative link assumes
# dotfiles and wali are siblings, which a worktree checkout breaks, and an
# absolute link writes this machine's layout into git. Resolve the registered
# wali checkout via `tasks projects --paths --json` when available, falling
# back to `${WORKTREE_SCAN_ROOT:-$HOME/d}/wali` when unregistered.

root=""
if command -v tasks >/dev/null 2>&1; then
    if ! command -v python3 >/dev/null 2>&1; then
        echo "walictl: python3 is required when tasks is installed" >&2
        exit 1
    fi
    if ! json_out="$(tasks projects --paths --json)"; then
        echo "walictl: tasks projects --paths --json failed" >&2
        exit 1
    fi
    if ! root="$(printf '%s' "$json_out" | python3 -c '
import json, sys
try:
    payload = json.load(sys.stdin)
except Exception as exc:
    sys.stderr.write(f"walictl: invalid JSON from tasks projects --paths --json: {exc}\n")
    sys.exit(2)
if not isinstance(payload, dict) or not isinstance(payload.get("projects"), list):
    sys.stderr.write("walictl: expected {\"projects\": [...]} from tasks projects --paths --json\n")
    sys.exit(2)
for row in payload["projects"]:
    if not isinstance(row, dict):
        sys.stderr.write("walictl: invalid project entry in tasks projects --paths --json\n")
        sys.exit(2)
    if row.get("prefix") == "wali":
        root = row.get("root")
        if not isinstance(root, str) or not root:
            sys.stderr.write("walictl: invalid root for prefix \x27wali\x27\n")
            sys.exit(2)
        print(root)
        break
')"; then
        exit 1
    fi
fi

if [[ -z "$root" ]]; then
    root="${WORKTREE_SCAN_ROOT:-${HOME}/d}/wali"
fi

exec "${root}/bin/walictl" "$@"
