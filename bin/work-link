#!/usr/bin/env zsh
# work-link: keep a checkout's git worktrees and generated build directories on
# host-local storage, off the synced tree, and reach them through in-tree symlinks.
#
# Same name, other disk: for an entry at <root>/<rel>/<name>, the storage is
# <anchor>/<rel>/<name> and the in-tree entry is a relative symlink to it
# (../ per segment of <rel>, one more, then .dropbox-work/<rel>/<name>). The
# anchor is <root>/../.dropbox-work, beside the synced root and outside it, so
# the link text is the same on every host that syncs the tree and each host
# decides where it lands. Names: .worktrees, .venv, and target (only beside
# Cargo.toml). node_modules stays in-tree: npm workspace links are relative and
# escape the directory.
#
#   work-link [--root DIR] [PATH ...]                converge: report, relink, lock
#   work-link --migrate [--dry-run] [--root DIR] [PATH ...]
#   work-link --ensure [--root DIR] NAME ...           inside a repository
#
# WORK_ROOT set: the anchor is a link to it. Unset: the anchor is a local
# directory. WORK_ROOT set but not a directory: the storage is unavailable and
# every mode refuses, so nothing is rebuilt elsewhere during an outage.
# WORK_ROOT itself is never created here: it is a mount point on the root
# filesystem, and mkdir -p would rebuild the tree on the wrong disk.
# Design: ops docs/specs/2026-09-14-checkout-local-storage-design.md, amended
# by docs/specs/2026-09-23-host-neutral-work-links-design.md
set -euo pipefail

typeset -ga WORK_LINK_NAMES=(.worktrees .venv target)
# A worktree's lock names the host that owns it: a missing worktree's recorded
# path cannot (a migrated one keeps its in-tree path, the same string on every
# host), so the lock is what tells another host's worktree from local breakage.
typeset -g WORK_LINK_HOST="${WORK_LINK_HOST:-$(uname -n)}"
typeset -g WORK_LINK_LOCK_PREFIX="on WORK_ROOT storage"
typeset -g WORK_LINK_LOCK_REASON="${WORK_LINK_LOCK_PREFIX} (host: ${WORK_LINK_HOST})"
typeset -g WORK_LINK_ANCHOR_NAME=.dropbox-work
typeset -g WORK_LINK_STORE=""

work_link_usage() {
  cat <<'EOF'
Usage: work-link [--root DIR] [PATH ...]
       work-link --migrate [--dry-run] [--root DIR] [PATH ...]
       work-link --ensure [--root DIR] NAME ...

Keep .worktrees, .venv and Cargo target directories off the synced tree,
behind relative in-tree symlinks through the anchor <root>/../.dropbox-work
(a link to $WORK_ROOT when it is set, a local directory otherwise). Converge
reports drift, relinks entries whose external copy exists, materializes the
target of a link that arrived from another host, rewrites this host's old
absolute links, and locks worktrees in the store. --migrate moves real
directories out (refusing any with open file handles). --ensure creates the
external directory and link for the named entries in the current repository,
adding the bare name to the clone's .git/info/exclude when its rules would
not ignore the link; outside the scan root (--root DIR, default ~/d) it
reports `outside` and leaves the entry in-tree.
EOF
}

work_link_refuse_unavailable() {
  print -u2 -- "WORK_ROOT is set to ${WORK_ROOT} but it is not a directory: storage unavailable, refusing"
  return 1
}

# Find or create the anchor beside the scan root and set WORK_LINK_STORE to
# its physical path. WORK_ROOT (already resolved by main) set: the anchor must
# be a link to it. Unset: a real directory. Anything else refuses; moving
# storage behind an anchor is done by hand, as migration is.
work_link_prepare_anchor() {
  local root="$1" anchor="${1:h}/${WORK_LINK_ANCHOR_NAME}"
  # The anchor must be outside the synced tree, or it and everything behind it
  # syncs. The Dropbox root carries a regular file named .dropbox (the
  # client's config directory of the same name in $HOME is not a marker).
  local dir="${root:h}"
  while true; do
    [[ -f "${dir}/.dropbox" ]] && {
      print -u2 -- "anchor ${anchor} would be inside the Dropbox folder ${dir}; scan from the Dropbox folder itself"
      return 1
    }
    [[ "$dir" == / ]] && break
    dir="${dir:h}"
  done
  if [[ -n "${WORK_ROOT:-}" ]]; then
    if [[ -L "$anchor" ]]; then
      [[ -e "$anchor" ]] || {
        print -u2 -- "anchor ${anchor} dangles ($(readlink -- "$anchor")): storage unavailable, refusing"
        return 1
      }
      local resolved; resolved=$(readlink -f -- "$anchor")
      [[ "$resolved" == "$WORK_ROOT" ]] || {
        print -u2 -- "anchor ${anchor} resolves to ${resolved}, not WORK_ROOT ${WORK_ROOT}; repoint it by hand"
        return 1
      }
    elif [[ -e "$anchor" ]]; then
      print -u2 -- "anchor ${anchor} is not a link to WORK_ROOT ${WORK_ROOT}; move its content under WORK_ROOT and replace it by hand"
      return 1
    else
      ln -s -- "$WORK_ROOT" "$anchor" || { print -u2 -- "cannot create anchor ${anchor}"; return 1; }
      print -- "created	${anchor}	-> ${WORK_ROOT}"
    fi
  else
    if [[ -L "$anchor" ]]; then
      print -u2 -- "anchor ${anchor} is a link but WORK_ROOT is unset; set WORK_ROOT to its target or replace it by hand"
      return 1
    elif [[ -e "$anchor" && ! -d "$anchor" ]]; then
      print -u2 -- "anchor ${anchor} exists and is not a directory"
      return 1
    elif [[ ! -e "$anchor" ]]; then
      mkdir -- "$anchor" || { print -u2 -- "cannot create anchor ${anchor}"; return 1; }
      print -- "created	${anchor}	-> local directory"
    fi
  fi
  WORK_LINK_STORE=$(readlink -f -- "$anchor")
}

# The link text for <root>/<entryrel>: up out of the entry's directory and
# out of the synced root, then into the anchor. The same on every host.
work_link_link_text() {
  local entryrel="$1" dir="${1:h}" up="../" seg
  if [[ "$dir" != . ]]; then
    for seg in "${(@s:/:)dir}"; do up+="../"; done
  fi
  print -- "${up}${WORK_LINK_ANCHOR_NAME}/${entryrel}"
}

# Candidate entries under a scan root: top-level matches of the names, never
# following symlinks, never descending into a match (a worktree's own .venv is
# part of the worktree). Byte-ordered.
work_link_candidates() {
  local root="$1"
  [[ -d "$root" ]] || { print -u2 -- "Scan root is not a directory: $root"; return 1; }
  local pattern='^(\.worktrees|\.venv|target)$'
  # Command substitution, not a process substitution loop: a failing fd must
  # abort the run (set -e), not be swallowed as an empty scan.
  local -a found
  found=("${(@0)$(fd -uu -0 -t d -t l --prune "$pattern" "$root")}") || {
    print -u2 -- "Scan failed under ${root} (fd exit $?)"
    return 1
  }
  found=("${(@)found:#}")
  found=("${(@)found%/}")
  local candidate
  local LC_COLLATE=C
  local -a kept
  local existing skip
  for candidate in ${(o)found}; do
    skip=false
    for existing in "${kept[@]}"; do
      [[ "$candidate" == "$existing" || "$candidate" == "$existing"/* ]] && { skip=true; break; }
    done
    [[ "$skip" == false ]] && kept+=("$candidate")
  done
  (( ${#kept} )) && printf '%s\n' "${kept[@]}"
  return 0
}

# Is this in-tree path a relocatable entry? target only beside Cargo.toml.
work_link_is_entry() {
  local entry="$1" name="${1:t}"
  case "$name" in
    .worktrees|.venv) return 0 ;;
    target) [[ -f "${entry:h}/Cargo.toml" ]] ;;
    *) return 1 ;;
  esac
}

# The repository that owns an in-tree path: nearest ancestor with a .git entry.
work_link_repo_of() {
  local dir="${1:h}"
  while [[ "$dir" != "/" ]]; do
    [[ -e "$dir/.git" ]] && { print -- "$dir"; return 0; }
    dir="${dir:h}"
  done
  return 1
}

# Classify an in-tree path. TEXT is the relative link this tool writes; LEGACY
# is this host's absolute form from before the anchor ($WORK_ROOT/<rel>/<name>,
# empty when WORK_ROOT is unset). Prints one word.
work_link_classify() {
  local intree="$1" external="$2" text="$3" legacy="$4"
  if [[ -L "$intree" ]]; then
    local target
    target=$(readlink -- "$intree")
    if [[ "$target" == "$text" ]]; then
      [[ -e "$intree" ]] && print -- linked || print -- materialize
    elif [[ -n "$legacy" && "$target" == "$legacy" ]]; then
      print -- legacy
    else
      print -- foreign
    fi
  elif [[ -d "$intree" ]]; then
    if [[ -d "$external" ]] && [[ -n "$(ls -A -- "$external")" ]]; then
      print -- conflict
    else
      print -- needs-migration
    fi
  elif [[ -e "$intree" ]]; then
    print -- foreign
  elif [[ -d "$external" ]]; then
    print -- relink
  else
    print -- absent
  fi
}

work_link_size() {
  du -sh -- "$1" 2>/dev/null | cut -f1
}

# Will the entry be ignored once it is a symlink? git matches a trailing-slash
# pattern (.venv/) only against a directory, so the real directory awaiting
# migration says nothing about the link that replaces it. The verdict is taken
# in a scratch work-tree that carries copies of the repository's .gitignore
# chain and nothing at the entry's path: git judges a missing path the way it
# judges a symlink. The repository's own rules count, .git/info/exclude included
# (a shared repository's tracked rule is not ours to change); the global
# excludes file does not. Prints ok, unignored, or slash; a failed probe
# returns 1 with the reason on stderr.
work_link_ignore_verdict() {
  local intree="$1" repo gitdir rel scratch dir line pattern rc
  repo=$(work_link_repo_of "$intree") || { print -- ok; return 0; }
  gitdir=$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null) || {
    print -u2 -- "git cannot open ${repo}"
    return 1
  }
  rel="${intree#"$repo"/}"
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/work-link-ignore.XXXXXX") || {
    print -u2 -- "mktemp failed"
    return 1
  }
  {
    local -a dirs=("$repo")
    dir="$repo"
    local part
    for part in "${(@s:/:)${rel:h}}"; do
      [[ "$part" == . ]] && continue
      dir="${dir}/${part}"
      dirs+=("$dir")
    done
    for dir in "${dirs[@]}"; do
      [[ -f "${dir}/.gitignore" ]] || continue
      mkdir -p -- "${scratch}/${dir#"$repo"}" || { print -u2 -- "cannot build the ignore probe"; return 1; }
      cp -- "${dir}/.gitignore" "${scratch}/${dir#"$repo"}/.gitignore" || { print -u2 -- "cannot build the ignore probe"; return 1; }
    done
    rc=0
    line=$(git --git-dir="$gitdir" --work-tree="$scratch" -c core.excludesFile=/dev/null \
      check-ignore -v --no-index -- "$rel" 2>&1) || rc=$?
    if (( rc == 0 )); then
      pattern="${${line%%	*}##*:}"
      if [[ "$pattern" == !* ]]; then print -- unignored
      elif [[ "$pattern" == */ ]]; then print -- slash
      else print -- ok
      fi
      return 0
    elif (( rc != 1 )); then
      print -u2 -- "check-ignore failed (exit ${rc}): ${line}"
      return 1
    fi
    # The link would not be ignored. Say whether a slash-form rule is the reason.
    if line=$(git -C "${intree:h}" -c core.excludesFile=/dev/null check-ignore -v --no-index -- "${intree:t}" 2>/dev/null) \
        && [[ "${${line%%	*}##*:}" == */ ]]; then
      print -- slash
    else
      print -- unignored
    fi
    return 0
  } always {
    rm -rf -- "$scratch"
  }
}

work_link_check_ignore() {
  local intree="$1" verdict
  verdict=$(work_link_ignore_verdict "$intree" 2>&1) || {
    work_link_report failed "$intree" "ignore probe failed: ${verdict}; not moved"
    return 1
  }
  case "$verdict" in
    ok) return 0 ;;
    slash) work_link_report unignored "$intree" "repository rule ends in /, which matches a directory but not a symlink; use the bare name ${intree:t} (in .gitignore or .git/info/exclude)"; return 1 ;;
    unignored) work_link_report unignored "$intree" "repository rules do not ignore ${intree:t}; add the bare name to .gitignore or .git/info/exclude"; return 1 ;;
    *) work_link_report failed "$intree" "ignore probe printed '${verdict}'; not moved"; return 1 ;;
  esac
}

# Does a stale record at PATH belong to a repository that moved to REPO?
# A worktree recorded inside the repository's previous top level moved along
# with it, so its .git file now sits at the same relative path inside the
# repository's current top and still names the same worktree admin entry.
# A worktree deliberately checked out outside the repository — a sibling of
# it under another directory of the scan root — has no such copy, whatever
# its lock says, so the move must not be inferred from the location alone.
work_link_record_moved_with_repo() {
  local repo="$1" root="$2" rec="$3" admin entry entry_path name rest candidate
  admin=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  entry=""
  for name in "$admin/worktrees"/*(N); do
    [[ -f "${name}/gitdir" ]] || continue
    entry_path=$(<"${name}/gitdir")
    # The recorded path can contain spaces: compare it whole. git writes
    # "<worktree>/.git"; accept the bare directory too.
    [[ "$entry_path" == "${rec}/.git" || "$entry_path" == "$rec" ]] && {
      entry="${name:t}"
      break
    }
  done
  [[ -n "$entry" ]] || return 1
  local a="$rec"
  while [[ "$a" != "$root" && "$a" != "/" ]]; do
    a="${a:h}"
    [[ "$a" == "$root" ]] && break
    rest="${rec#$a}"
    candidate="${repo}${rest}/.git"
    # The name must end the reference: agent must not match worktrees/agent1.
    if [[ -f "$candidate" && "$(<"$candidate")" == *"worktrees/${entry}" ]]; then
      return 0
    fi
  done
  return 1
}

# Lock every worktree inside a .worktrees entry that resolves under the store,
# each through its own repository: a worktree parked here may belong to another
# repository, and only that repository's prune would delete it. Then report the
# owning repository's entries that git itself marks prunable, or whose recorded
# path no longer resolves. When the recorded path sits under the scan root
# but outside the repository's current top level and the worktree itself
# moved along with the repository, the repository moved: no host owns the
# record, whatever its lock names, and unlock plus prune clears it. A
# worktree deliberately checked out outside the repository has no copy
# inside it and keeps the lock's classification: this host's is breakage,
# another host's is skipped, a lock that names no host is `unowned`.
work_link_lock_worktrees() {
  local dotwt="$1" root="$2" child real gitdir current tmp desc
  for child in "$dotwt"/*(N/); do
    [[ -L "$child" ]] && continue                      # a cross-project symlink, not a worktree
    [[ -f "$child/.git" ]] || continue                 # a plain directory parked here
    real=$(realpath -- "$child") || {
      work_link_report failed "$child" "realpath could not resolve it: not locked"
      continue
    }
    [[ "$real" == "$WORK_LINK_STORE"/* ]] || continue
    gitdir=$(git -C "$child" rev-parse --path-format=absolute --git-dir 2>/dev/null) || {
      work_link_report broken "$child" "has a .git file but git cannot open it"
      continue
    }
    if [[ -f "$gitdir/locked" ]]; then
      # A bare lock, or one git took with no reason given (empty, or "added
      # with --lock"), on a worktree that exists here is this host's:
      # restamp it so other hosts can tell it is not theirs. The reason is
      # written in one rename, so the worktree is never unlocked, not even
      # for a moment another host's prune could see through Dropbox. Any
      # other reason is someone else's lock and is left alone.
      current=$(<"$gitdir/locked")
      [[ -z "$current" || "$current" == "added with --lock" || "$current" == "$WORK_LINK_LOCK_PREFIX" ]] || continue
      tmp="${gitdir}/locked.work-link.$$"
      if printf '%s' "$WORK_LINK_LOCK_REASON" > "$tmp" && mv -f -- "$tmp" "$gitdir/locked"; then
        print -- "relocked	${child}	${WORK_LINK_LOCK_REASON}"
      else
        rm -f -- "$tmp"
        work_link_report failed "$child" "restamping the lock with the host name failed"
      fi
      continue
    fi
    if git -C "$child" worktree lock --reason "$WORK_LINK_LOCK_REASON" -- "$child"; then
      print -- "locked	${child}"
    else
      work_link_report failed "$child" "git worktree lock failed"
    fi
  done
  local repo listing line wt="" reason="" i
  repo=$(work_link_repo_of "$dotwt") || return 0
  # A failing listing is not an empty one: git worktree list is the only source
  # for what the owning repository still records, so its failure is reported.
  listing=$(git -C "$repo" worktree list --porcelain 2>/dev/null) || {
    work_link_report failed "$dotwt" "git worktree list failed in ${repo}; prunable entries not checked"
    return 0
  }
  # Path resolution alone misses what git already knows: a worktree whose .git
  # file is gone or broken is marked prunable in the listing while its recorded
  # path still resolves, so git's own prunable mark decides first.
  local -a wts=() reasons=() locks=()
  local lock=""
  for line in "${(@f)listing}"; do
    if [[ "$line" == worktree\ * ]]; then
      wts+=("$wt"); reasons+=("$reason"); locks+=("$lock")
      wt="${line#worktree }"; reason=""; lock=""
    elif [[ "$line" == prunable* ]]; then
      reason="${${line#prunable}# }"
    elif [[ "$line" == locked ]]; then
      lock="(no reason)"
    elif [[ "$line" == locked\ * ]]; then
      lock="${line#locked }"
    fi
  done
  wts+=("$wt"); reasons+=("$reason"); locks+=("$lock")
  for (( i = 1; i <= ${#wts}; i++ )); do
    [[ -n "${wts[$i]}" ]] || continue
    if [[ -n "${reasons[$i]}" ]]; then
      work_link_report prunable "${wts[$i]}" "git marks it prunable (${reasons[$i]}); git -C ${repo} worktree prune would remove it"
    elif ! realpath -e -- "${wts[$i]}" >/dev/null 2>&1; then
      if [[ "${wts[$i]}" == "$root"/* && "${wts[$i]}" != "$repo"/* ]] \
        && work_link_record_moved_with_repo "$repo" "$root" "${wts[$i]}"; then
        # The repository itself moved: the record points at its previous
        # location, which no lock can keep alive and no host can relock.
        desc="locked (${locks[$i]})"
        [[ -z "${locks[$i]}" ]] && desc="no lock"
        case "${locks[$i]}" in
          "$WORK_LINK_LOCK_REASON") desc="locked for this host" ;;
          "${WORK_LINK_LOCK_PREFIX} (host: "*) desc="locked for another host (${locks[$i]})" ;;
        esac
        [[ "${locks[$i]}" == "claude agent agent-"*\ \(pid\ *\) ]] && desc="a Claude Code agent lock (${locks[$i]})"
        # The suggested commands must run as printed: paths are single-quoted
        # with embedded apostrophes spelled '\''.
        work_link_report prunable "${wts[$i]}" "${desc} at the repository's previous location: the repository moved to ${repo}; git -C ${(qq)repo} worktree unlock ${(qq)wts[$i]} and git -C ${(qq)repo} worktree prune would remove it"
      else
        case "${locks[$i]}" in
          "")
            work_link_report prunable "${wts[$i]}" "recorded in ${repo} but the path does not resolve" ;;
          "$WORK_LINK_LOCK_REASON")
            work_link_report prunable "${wts[$i]}" "locked for this host but the path does not resolve: its storage is gone" ;;
          "${WORK_LINK_LOCK_PREFIX} (host: "*)
            ;;  # another host's worktree: absent here by design, kept by its lock
          *)
            desc="locked (${locks[$i]})"
            [[ "${locks[$i]}" == "claude agent agent-"*\ \(pid\ *\) ]] && desc="a Claude Code agent lock (${locks[$i]})"
            work_link_report unowned "${wts[$i]}" "${desc} with no host named and the path does not resolve here; relock it on the host that owns it" ;;
        esac
      fi
    fi
  done
}

# Keep a repository's worktree admin directory (<git common dir>/worktrees)
# with the host that owns its worktrees: marked com.dropbox.ignored, it never
# syncs, so no other host can delete it by ignoring a synced copy. An entry is
# local when the path in its gitdir file exists here. MODE ensure creates the
# directory when missing and runs before git worktree add; converge and
# migrate only mark an existing one; plan prints what it would mark.
# Unmarked with only missing entries: another host's, left alone (ensure
# reports it). Missing entries beside local ones: shared-admin, because
# marking would delete the other host's entries there.
work_link_mark_admin() {
  local repo="$1" mode="$2" common admin entry target
  local -i here=0 missing=0
  common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
    [[ "$mode" == ensure ]] && { print -u2 -- "work-link --ensure: git cannot name the common git directory of ${repo}"; return 1; }
    work_link_report failed "$repo" "git cannot name the common git directory"
    return 0
  }
  admin="${common}/worktrees"
  if [[ ! -d "$admin" ]]; then
    [[ "$mode" == ensure ]] || return 0
    mkdir -- "$admin" || { print -u2 -- "work-link --ensure: cannot create ${admin}"; return 1; }
  fi
  [[ "$(attr -q -g com.dropbox.ignored "$admin" 2>/dev/null)" == 1 ]] && return 0
  for entry in "$admin"/*(N/); do
    target=""
    [[ -f "${entry}/gitdir" ]] && target=$(<"${entry}/gitdir")
    if [[ -n "$target" && -e "$target" ]]; then
      here+=1
    else
      missing+=1
    fi
  done
  if (( missing > 0 )); then
    if [[ "$mode" == ensure ]]; then
      print -- "shared-admin	${admin}	holds ${missing} worktree(s) missing here, left unmarked; marking would delete them on the host that has them"
    elif (( here > 0 )); then
      work_link_report shared-admin "$admin" "${here} worktree(s) here and ${missing} missing here; marking would delete the missing ones on the host that has them: resolve by hand"
    fi
    return 0
  fi
  if [[ "$mode" == plan ]]; then
    print -- "ignore	${admin}"
    return 0
  fi
  if attr -q -s com.dropbox.ignored -V 1 "$admin"; then
    print -- "ignored	${admin}"
  elif [[ "$mode" == ensure ]]; then
    print -u2 -- "work-link --ensure: cannot mark ${admin} ignored"
    return 1
  else
    work_link_report failed "$admin" "cannot mark it ignored"
  fi
}

typeset -gi WORK_LINK_REPORTED=0
typeset -g WORK_LINK_MODE=converge

# Reports (as opposed to the actions moved/relinked/materialized/rewritten/
# relocked/locked/removed-orphan, which mean the named change happened): needs-migration,
# conflict, foreign, unignored, orphan, prunable, unowned, broken, busy,
# uninspectable, and failed (a
# mutating command that should have succeeded did not: see work_link_move,
# the relink branch of work_link_handle, and work_link_lock_worktrees).
# In converge, needs-migration and conflict are standing work that a person
# does by hand: they are printed but do not fail the run, so a failed timer
# unit means something new. --migrate still fails on a conflict.
work_link_report() {
  # printf, not print: message text is printed raw, so an escaped
  # apostrophe in a suggested command survives.
  printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}"
  if [[ "$WORK_LINK_MODE" == converge && ( "$1" == needs-migration || "$1" == conflict ) ]]; then
    return 0
  fi
  WORK_LINK_REPORTED=$((WORK_LINK_REPORTED + 1))
}

# Processes holding files open anywhere under a directory, one "pid command"
# per line. lsof exits 1 both when nothing is open and when it failed; only
# stderr tells them apart. Both streams are captured together (no temp file,
# so there is no file creation or redirection that could itself fail
# unnoticed): with -F pc every stdout line starts with p or c, so any other
# line is stderr, and any such line or an exit above 1 is an inspection
# failure. Callers run this in a || context where set -e is off, so every
# status is checked here explicitly.
work_link_open_handles() {
  local dir="$1" out rc=0
  out=$(lsof +D "$dir" -F pc 2>&1) || rc=$?
  local -a lines noise
  lines=("${(@f)out}")
  noise=("${(@M)lines:#[^pc]*}")
  noise=("${(@)noise:#}")
  if (( rc > 1 )) || (( ${#noise} )); then
    print -- "inspection failed (lsof exit ${rc}): ${noise[1]:-no message}"
    return 1
  fi
  local handles
  handles=$(print -l -- "${lines[@]}" | awk '/^p/{pid=substr($0,2)} /^c/{print pid, substr($0,2)}' | sort -u) || {
    print -- "inspection failed: could not parse lsof output"
    return 1
  }
  print -- "$handles"
}

# Move an in-tree directory to its external path and leave the link. Returns
# non-zero if any step fails (a full disk, a read-only external parent, a
# permission error): the caller must not report success when this fails.
# Explicit `|| return 1` on each step rather than relying on `set -e`: this
# function is invoked deep under a `... || return 1` call chain, and in zsh
# that suppresses ERR_EXIT for the whole call tree, so a failing mv or ln -s
# would otherwise be silently swallowed.
work_link_move() {
  local intree="$1" external="$2" text="$3"
  mkdir -p -- "${external:h}" || return 1
  if [[ -d "$external" ]]; then
    rmdir -- "$external" || return 1
  fi
  mv -- "$intree" "$external" || return 1
  ln -s -- "$text" "$intree" || return 1
}

# Replace a link with TEXT in one rename, so the path never stops resolving:
# the new link is made under a temporary name beside it and renamed over it
# (rename(2) replaces the link itself, not what it points at).
work_link_rewrite() {
  local intree="$1" text="$2" tmp="${1:h}/.${1:t}.work-link.$$"
  ln -s -- "$text" "$tmp" || return 1
  mv -T -- "$tmp" "$intree" || { rm -f -- "$tmp"; return 1; }
}

# Converge or migrate one entry. Mode is converge, migrate, or plan.
work_link_handle() {
  local mode="$1" intree="$2" root="$3"
  local rel="${intree#$root/}"
  local external="${WORK_LINK_STORE}/${rel}"
  local text; text=$(work_link_link_text "$rel")
  local legacy=""
  [[ -n "${WORK_ROOT:-}" ]] && legacy="${WORK_ROOT}/${rel}"
  local state
  state=$(work_link_classify "$intree" "$external" "$text" "$legacy")
  case "$state" in
    linked)
      work_link_check_ignore "$intree" || true
      ;;
    relink)
      if [[ "$mode" == plan ]]; then
        print -- "relink	${intree}	<- ${external}"
      elif ln -s -- "$text" "$intree"; then
        print -- "relinked	${intree}	<- ${external}"
      else
        work_link_report failed "$intree" "relink to ${external} failed"
      fi
      ;;
    needs-migration)
      case "$mode" in
        converge)
          work_link_report needs-migration "$intree" "$(work_link_size "$intree") -> ${external}"
          work_link_check_ignore "$intree" || true
          ;;
        plan|migrate)
          local ignore_ok=true
          work_link_check_ignore "$intree" || ignore_ok=false
          local holders="" inspect_ok=true
          holders=$(work_link_open_handles "$intree") || inspect_ok=false
          holders="${(j:, :)${(f)holders}}"
          if [[ "$inspect_ok" == false ]]; then
            work_link_report uninspectable "$intree" "${holders}; not moved"
          elif [[ -n "$holders" ]]; then
            work_link_report busy "$intree" "$(work_link_size "$intree") -> ${external}; open handles: ${holders}; stop them and rerun"
          elif [[ "$ignore_ok" == false ]]; then
            print -- "held	${intree}	fix the ignore rule first"
          elif [[ "$mode" == plan ]]; then
            print -- "move	${intree}	$(work_link_size "$intree") -> ${external}"
          elif work_link_move "$intree" "$external" "$text"; then
            print -- "moved	${intree}	-> ${external}"
          else
            work_link_report failed "$intree" "move to ${external} failed"
          fi
          ;;
      esac
      ;;
    conflict)
      work_link_report conflict "$intree" "real directory ($(work_link_size "$intree")) and non-empty ${external} ($(work_link_size "$external")); delete one side"
      ;;
    materialize)
      if [[ "$mode" == plan ]]; then
        print -- "materialize	${intree}	-> ${external}"
      elif mkdir -p -- "$external"; then
        print -- "materialized	${intree}	-> ${external}"
      else
        work_link_report failed "$intree" "cannot create ${external}"
      fi
      ;;
    legacy)
      if [[ "$mode" == plan ]]; then
        print -- "rewrite	${intree}	${legacy} -> ${text}"
      elif work_link_rewrite "$intree" "$text"; then
        print -- "rewritten	${intree}	-> ${text}"
        if [[ ! -e "$intree" ]]; then
          mkdir -p -- "$external" && print -- "materialized	${intree}	-> ${external}" \
            || work_link_report failed "$intree" "cannot create ${external}"
        fi
      else
        work_link_report failed "$intree" "rewrite to ${text} failed"
      fi
      ;;
    foreign)
      work_link_report foreign "$intree" "not a link to ${text}"
      ;;
  esac
}

# Scan both sides: the in-tree scope for entries, and the store for external
# copies whose in-tree entry is gone (the relink case). Then lock worktrees.
work_link_run() {
  local mode="$1" root="$2" parent; shift 2
  local -a scopes
  scopes=("$@")
  (( ${#scopes} )) || scopes=("$root")

  local -A seen
  local scope candidate intree
  local -a candidates
  for scope in "${scopes[@]}"; do
    candidates=("${(@f)$(work_link_candidates "$scope")}") || return 1
    for candidate in "${candidates[@]}"; do
      [[ -n "$candidate" ]] || continue
      work_link_is_entry "$candidate" || continue
      seen[$candidate]=1
      work_link_handle "$mode" "$candidate" "$root"
    done
  done

  local external
  candidates=("${(@f)$(work_link_candidates "$WORK_LINK_STORE")}") || return 1
  for external in "${candidates[@]}"; do
    [[ -n "$external" ]] || continue
    intree="${root}/${external#$WORK_LINK_STORE/}"
    [[ -n "${seen[$intree]:-}" ]] && continue
    local in_scope=false
    for scope in "${scopes[@]}"; do
      [[ "$intree" == "$scope" || "$intree" == "$scope"/* ]] && { in_scope=true; break; }
    done
    [[ "$in_scope" == true ]] || continue
    seen[$intree]=1
    if [[ ! -d "${intree:h}" ]]; then
      # Empty: a target materialized for a checkout another host has since
      # deleted or renamed. Nothing is lost by removing it and its empty
      # parents up to the store.
      if [[ -d "$external" && -z "$(ls -A -- "$external")" ]]; then
        if [[ "$mode" == plan ]]; then
          print -- "remove-orphan	${intree}	empty ${external}"
        elif rmdir -- "$external"; then
          parent="${external:h}"
          while [[ "$parent" == "$WORK_LINK_STORE"/* ]] && rmdir -- "$parent" 2>/dev/null; do
            parent="${parent:h}"
          done
          print -- "removed-orphan	${intree}	empty ${external}"
        else
          work_link_report failed "$intree" "cannot remove empty orphan ${external}"
        fi
        continue
      fi
      work_link_report orphan "$intree" "external ${external} has no checkout behind it; delete it by hand or restore the checkout"
      continue
    fi
    # A name that is not a relocatable entry in this checkout: an external
    # target with no Cargo.toml beside the in-tree path is storage nothing
    # claims, so it is reported rather than skipped silently.
    work_link_is_entry "$intree" || {
      work_link_report orphan "$intree" "external ${external} is a target with no Cargo.toml beside ${intree:h}; delete it by hand or add one"
      continue
    }
    work_link_handle "$mode" "$intree" "$root"
  done

  local repo
  for intree in "${(@ko)seen}"; do
    [[ "${intree:t}" == .worktrees && -L "$intree" && -d "$intree" ]] || continue
    [[ "$mode" == plan ]] || work_link_lock_worktrees "$intree" "$root"
    repo=$(work_link_repo_of "$intree") || continue
    work_link_mark_admin "$repo" "$mode"
  done
}

# Before --ensure links an entry: will this clone ignore the link? A shared
# repository's tracked rule may be the slash form that is not ours to change,
# and a fresh clone has no local rule yet, so the bare name goes into the
# clone's .git/info/exclude, git's file for exactly this. A repository whose
# own rules already cover the link is left alone; the write is reported.
work_link_ensure_excluded() {
  local intree="$1" verdict exclude
  verdict=$(work_link_ignore_verdict "$intree" 2>&1) || {
    print -u2 -- "work-link --ensure: ignore probe failed for ${intree}: ${verdict}"
    return 1
  }
  [[ "$verdict" == ok ]] && return 0
  exclude=$(git -C "${intree:h}" rev-parse --git-path info/exclude 2>/dev/null) || {
    print -u2 -- "work-link --ensure: git cannot name info/exclude for ${intree}"
    return 1
  }
  [[ "$exclude" == /* ]] || exclude="${intree:h}/${exclude}"
  mkdir -p -- "${exclude:h}" && printf '%s\n' "${intree:t}" >> "$exclude" || {
    print -u2 -- "work-link --ensure: cannot write ${exclude}"
    return 1
  }
  verdict=$(work_link_ignore_verdict "$intree" 2>&1) || return 1
  [[ "$verdict" == ok ]] || {
    print -u2 -- "work-link --ensure: ${intree} is still ${verdict} after writing ${exclude}"
    return 1
  }
  print -- "excluded	${intree}	${intree:t} added to ${exclude}"
}

work_link_ensure() {
  local root="$1"; shift
  local toplevel
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 -- "work-link --ensure: not inside a git repository"
    return 1
  }
  # The anchor is validated (and created when missing) before any write, as
  # in every mode. A scan root that does not exist means this host syncs
  # nothing: there is no anchor, and every checkout is outside.
  if [[ -d "$root" ]]; then
    work_link_prepare_anchor "$root" || return 1
  fi
  local name intree
  for name in "$@"; do
    case "$name" in
      .worktrees|.venv|target) ;;
      *) print -u2 -- "work-link --ensure: unknown name ${name} (use .worktrees, .venv, target)"; return 1 ;;
    esac
    intree="${toplevel}/${name}"
    # A worktree in the store: git reports its physical path, which is
    # outside the scan root, so this comes before the outside check.
    if [[ -n "$WORK_LINK_STORE" && "$toplevel" == "$WORK_LINK_STORE"/* ]]; then
      print -- "external	${intree}	already in the store"
      continue
    fi
    # Outside the scan root (a clone under a temp dir) nothing is covered: the
    # entry stays in-tree and setup goes on; only a dangling link goes. It is
    # the one link --ensure removes: that checkout is not synced.
    # A link that resolves is another matter: a `cp -r` of a project under
    # ~/d carries its symlinks along, so this can be a live link back into
    # another checkout's external storage. Refuse rather than leave it for the
    # installer that follows to write into that storage.
    [[ "$toplevel" == "$root"/* ]] || {
      if [[ -L "$intree" ]]; then
        if [[ -e "$intree" ]]; then
          local foreign_target
          foreign_target=$(readlink -- "$intree")
          print -u2 -- "work-link --ensure: ${intree} is a link into ${foreign_target} from a checkout outside ${root}; remove it or copy without symlinks"
          return 1
        fi
        rm -- "$intree"
      fi
      print -- "outside	${intree}	${toplevel} is not under ${root}; stays in-tree"
      continue
    }
    local rel="${toplevel#$root/}/${name}"
    local external="${WORK_LINK_STORE}/${rel}"
    local text; text=$(work_link_link_text "$rel")
    local legacy=""
    [[ -n "${WORK_ROOT:-}" ]] && legacy="${WORK_ROOT}/${rel}"
    local state
    state=$(work_link_classify "$intree" "$external" "$text" "$legacy")
    case "$state" in
      absent|relink|materialize|legacy) work_link_ensure_excluded "$intree" || return 1 ;;
    esac
    case "$state" in
      linked) print -- "ok	${intree}" ;;
      absent) mkdir -p -- "$external"; ln -s -- "$text" "$intree"; print -- "created	${intree}	-> ${external}" ;;
      relink) ln -s -- "$text" "$intree"; print -- "relinked	${intree}	-> ${external}" ;;
      materialize) mkdir -p -- "$external"; print -- "materialized	${intree}	-> ${external}" ;;
      legacy)
        work_link_rewrite "$intree" "$text" || { print -u2 -- "work-link --ensure: rewrite of ${intree} failed"; return 1; }
        [[ -e "$intree" ]] || mkdir -p -- "$external"
        print -- "rewritten	${intree}	-> ${text}" ;;
      needs-migration|conflict) print -- "needs-migration	${intree}	real directory, left for work-link --migrate ${toplevel}" ;;
      foreign) print -u2 -- "work-link --ensure: ${intree} exists and is not a link to ${text}"; return 1 ;;
    esac
    # Before git worktree add: the admin directory git is about to write is
    # already ignored, so nothing of it syncs.
    if [[ "$name" == .worktrees ]]; then
      work_link_mark_admin "$toplevel" ensure || return 1
    fi
  done
}

work_link_main() {
  local mode=converge dry_run=false root="" ensure=false
  local -a paths
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --migrate) mode=migrate ;;
      --dry-run) dry_run=true ;;
      --ensure) ensure=true ;;
      --root) shift; root="${1:?Missing value for --root}" ;;
      --help|-h) work_link_usage; return 0 ;;
      --) shift; paths+=("$@"); break ;;
      -*) print -u2 -- "Unknown option: $1"; work_link_usage >&2; return 2 ;;
      *) paths+=("$1") ;;
    esac
    shift
  done
  # --ensure runs from every project's setup and must work on a machine that has
  # only git; the scan needs fd, and only a migration needs lsof.
  local -a required=(git realpath)
  [[ "$ensure" == true ]] || required+=(fd attr)
  # --ensure needs attr only to mark the worktree admin directory.
  [[ "$ensure" == true ]] && (( ${paths[(Ie).worktrees]} )) && required+=(attr)
  [[ "$mode" == migrate || "$dry_run" == true ]] && required+=(lsof)
  local cmd
  for cmd in "${required[@]}"; do
    command -v "$cmd" >/dev/null || { print -u2 -- "Missing required command: $cmd"; return 127; }
  done

  if [[ -n "${WORK_ROOT:-}" ]]; then
    [[ -d "$WORK_ROOT" ]] || { work_link_refuse_unavailable; return 1; }
    # Normalized once: the anchor comparison and the legacy link form both
    # use it, and a trailing slash or a symlink component left unresolved
    # makes them disagree.
    WORK_ROOT=$(readlink -f -- "$WORK_ROOT")
  fi
  [[ -n "$root" ]] || root="${HOME}/d"
  root=$(readlink -f -- "$root") || { print -u2 -- "cannot resolve scan root ${root}"; return 1; }

  if [[ "$ensure" == true ]]; then
    (( ${#paths} )) || { print -u2 -- "work-link --ensure needs at least one name"; return 2; }
    work_link_ensure "$root" "${paths[@]}"
    return
  fi

  [[ -d "$root" ]] || { print -u2 -- "Scan root not found: $root"; return 1; }
  if [[ -n "${WORK_ROOT:-}" ]]; then
    [[ "$WORK_ROOT" == "$root"/* || "$root" == "$WORK_ROOT"/* ]] && {
      print -u2 -- "WORK_ROOT ${WORK_ROOT} and the scan root ${root} must not nest"
      return 1
    }
  fi
  work_link_prepare_anchor "$root" || return 1
  local -a scopes
  local p
  for p in "${paths[@]}"; do
    [[ -d "$p" ]] || { print -u2 -- "Not a directory: $p"; return 1; }
    p=$(readlink -f -- "$p")
    [[ "$p" == "$root" || "$p" == "$root"/* ]] || { print -u2 -- "Not under ${root}: $p"; return 1; }
    scopes+=("$p")
  done

  if [[ "$dry_run" == true ]]; then
    WORK_LINK_MODE=plan
    work_link_run plan "$root" "${scopes[@]}" || return 1
    return 0
  fi
  WORK_LINK_MODE="$mode"
  work_link_run "$mode" "$root" "${scopes[@]}" || return 1
  (( WORK_LINK_REPORTED == 0 ))
}

work_link_main "$@"
