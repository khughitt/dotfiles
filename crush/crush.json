{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "typescript": {
      "command": "npx",
      "args": ["--yes", "@vtsls/language-server", "--stdio"]
    },
    "python": {
      "command": "pyright",
      "args": ["--stdio"]
    }
  },
  "map": {
    "openrouter": {
      "type": "http",
      "url": "https://mcp.openrouter.ai/mcp",
      "timeout": 120,
      "disabled": false
    }
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "glob",
      "grep"
    ]
  },
  "options": {
    "tui": {
      "compact_mode": true,
      "diff_mode": "unified"
    },
    "attribution": {
      "trailer_style": "none",
      "generated_with": false
    },
    "disable_metrics": true
  }
}
