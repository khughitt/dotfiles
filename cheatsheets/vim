# yank a single character
vy

# yanks, deletes, and changes sync with CLIPBOARD (+) and PRIMARY (*)
# x is the exception: it deletes to the small-delete register without syncing
x
"-p

# use a specific system clipboard explicitly
"+y
"*y
"+p
"*p

# delete up to next word
dw
ldw

# go to start/end of line when wrapping is enabled
g0
g$

# macros
Qx (record..)
Q  (stop recording)
@x (replay)

# toggle comments
<space>

# add string to end of each line
1. c-v (select lines)
2. $
3. A<text>
4. esc

# edit multiple files
:args path/to/*.py

# show all highlight groups
# see also: https://vim.fandom.com/wiki/Xterm256_color_names_for_console_Vim
:so $VIMRUNTIME/syntax/hitest.vim

# clean run
nvim --clean

# show error, etc. messages
:messages

# print hex for a single hilite group
:hi Normal

# toggle line numbers
:set nu
:set nu!

# sort selected lines
:sort

# specify syntax at bottom of a file
# vi:syntax=python
