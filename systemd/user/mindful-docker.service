[Unit]
Description=Mindful v3 Docker Compose stack
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/mindful.env
WorkingDirectory=%h/d/mindful/v3
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=graphical-session.target
