# fzf

# fzf behavior stays stable; Noctalia rewrites the color options in place.
export FZF_DEFAULT_OPTS="--exact -1"
fzf_theme="${XDG_CACHE_HOME:-$HOME/.cache}/noctalia/fzf.conf"
[[ -r "$fzf_theme" ]] && export FZF_DEFAULT_OPTS_FILE="$fzf_theme"
unset fzf_theme

export FZF_CTRL_T_COMMAND="fd --type file --color=never"
export FZF_DEFAULT_COMMAND="fd --type file --color=never"

# Use fd (https://github.com/sharkdp/fd) instead of the default find
# command for listing path candidates.
# - The first argument to the function ($1) is the base path to start traversal
# - See the source code (completion.{bash,zsh}) for the details.
_fzf_compgen_path() {
  fd --hidden --follow --exclude ".git" . "$1"
}

# Use fd to generate the list for directory completion
_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" . "$1"
}

if [[ -o interactive && -t 0 && -t 1 ]] && (( $+commands[fzf] )); then
  source <(fzf --zsh)
  bindkey '^I' expand-or-complete
fi
