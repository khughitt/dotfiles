[user]
	email = keith.hughitt@gmail.com
	name = Keith Hughitt
[color]
	ui = true
[core]
	excludesfile = ~/.gitignore_global
	filemode = false
  ;disabling delta as default pager to avoid blocking
  ;pager = delta
[push]
	default = simple
  autoSetupRemote = true
[github]
	user = khughitt
[diff]
  colorMoved = default
  tool = meld
[difftool]
  prompt = false
[difftool "meld"]
  cmd = meld "$LOCAL" "$REMOTE"
[init]
	defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictstyle = diff3
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
# git matches gitdir against the canonical path, so a ~/d/ pattern never
# matches through the ~/d symlink; the leading **/ is layout-neutral.
[includeIf "gitdir:**/cainex/"]
	path = ~/.gitconfig-cainex
# Refuse a commit or merge whose author or committer is not the identity the
# checkout's profile declares (ops bin/git-identity-check; design: ops
# docs/specs/2026-10-16-commit-identity-guard-design.md). Config-declared hooks
# run in every repository beside its own core.hooksPath hooks. The system
# interpreter, so an older python3 first on PATH never decides the verdict.
[hook "identity-check"]
	event = pre-commit
	event = pre-merge-commit
	command = /usr/bin/python3 $HOME/.local/bin/git-identity-check
