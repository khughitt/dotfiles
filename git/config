[user]
	email = keith.hughitt@gmail.com
	name = Keith Hughitt
[color]
	ui = true
[core]
	excludesfile = ~/.gitignore_global
	filemode = false
  ;disabling delta as default pager to avoid blocking
  ;pager = delta
[push]
	default = simple
  autoSetupRemote = true
[github]
	user = khughitt
[diff]
  colorMoved = default
  tool = meld
[difftool]
  prompt = false
[difftool "meld"]
  cmd = meld "$LOCAL" "$REMOTE"
[init]
	defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictstyle = diff3
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
# git matches gitdir against the canonical path, so a ~/d/ pattern never
# matches through the ~/d symlink; the leading **/ is layout-neutral.
[includeIf "gitdir:**/cainex/"]
	path = ~/.gitconfig-cainex
# Refuse a commit or merge whose author or committer is not the identity the
# checkout's profile declares (ops bin/git-identity-check; design: ops
# docs/specs/2026-10-16-commit-identity-guard-design.md). Config-declared hooks
# run in every repository beside its own core.hooksPath hooks. The script on PATH,
# else the one under $HOME: a test that sandboxes HOME (still reading this file
# through XDG_CONFIG_HOME) or rewrites PATH reaches it either way. The script's
# #!/usr/bin/python3 shebang keeps an older python3 first on PATH from deciding.
[hook "identity-check"]
	event = pre-commit
	event = pre-merge-commit
	command = command -v git-identity-check >/dev/null && exec git-identity-check || exec \"$HOME/.local/bin/git-identity-check\"
# Shared config also reaches hosts without the guard installed; warn there.
[hook "index-health"]
	event = pre-commit
	event = pre-merge-commit
	command = "if command -v git-index-health >/dev/null 2>&1; then exec git-index-health --guard; elif test -x \"$HOME/.local/bin/git-index-health\"; then exec \"$HOME/.local/bin/git-index-health\" --guard; else echo 'git-index-health: not installed; no index check ran' >&2; fi"
