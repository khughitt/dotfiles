# Overrides gnome-keyring's packaged file, which has no SystemdService=: without it,
# dbus-broker activates its own gnome-keyring-daemon beside the socket-activated
# gnome-keyring-daemon.service, leaving two daemons. Routing activation through the
# unit keeps one.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
