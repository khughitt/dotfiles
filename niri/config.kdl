// Niri config.
//
// Keep Hyprland-specific settings out of this file. Noctalia owns wallpaper,
// shell widgets, and generated colors; Niri owns compositor behavior.

include "./noctalia.kdl"
include "./prism.kdl"
include "./host.kdl"


environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    GDK_BACKEND "wayland"
    MOZ_ENABLE_WAYLAND "1"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    _JAVA_AWT_WM_NONREPARENTING "1"
}

// Keep theme and size in lockstep with gtk-3.0/ and gtk-4.0/settings.ini and with
// gsettings org.gnome.desktop.interface — GTK reads those, not the XCURSOR_* env
// niri exports, so a mismatch makes the pointer resize as it crosses windows.
// Adwaita's native sizes are 24/30/36/48/72/96; anything else gets resampled soft.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 30

    // Get the pointer out of the way of text you are reading or typing over. Both
    // are pure compositor-side hiding — any movement or click brings it straight back.
    hide-when-typing
    hide-after-inactive-ms 5000
}

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
        }
    }

    touchpad {
        tap
        drag-lock
        natural-scroll
    }

    // focus-follows-mouse
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    center-focused-column "never" // "on-overflow"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        width 4
        active-gradient from="#33563355" to="#99f09066" angle=45 relative-to="workspace-view"
    }

    border {
        off
    }

    shadow {
        on
        softness 5
        spread 1
        offset x=-5 y=5
        color "#00000070"
    }
    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 0
        width 5
        length total-proportion=0.98
        position "left"
        gaps-between-tabs 4
        corner-radius 2
    }

    // TESTING (2026-08-03)
    insert-hint {
        on
        color "#ffc87f80"
        gradient from="#ffbb6680" to="#ffc88080" angle=45 relative-to="workspace-view"
    }

    background-color "transparent"
}

overview {
    workspace-shadow {
        off
    }
    zoom 0.25
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/d/pics/screenshots/%Y-%m-%d_%H-%M-%S.png"

spawn-at-startup "noctalia"
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
spawn-at-startup "~/.config/niri/scripts/fill-new-window"
spawn-sh-at-startup "qs -p ~/d/software/ohai/ohai/shell.qml"
spawn-at-startup "qs" "-c" "niri-glass"
spawn-sh-at-startup "node ~/d/software/ohai/bin/ohai-mcp"

// Replaces `ohai-status reset`, whose binary is deleted — familiar owns agent state now.
// Retained workspace-awareness feed: niri-windows.json maps windows to workspaces and
// resyncs on every window/workspace event and every change to agents.json. A SessionStart
// hook cannot follow later moves; if the watcher dies, this feed goes stale.
spawn-sh-at-startup "~/d/familiar/bin/familiar-niri watch"
spawn-sh-at-startup "qs -d -p ~/d/familiar/integrations/niri-desktop"

prefer-no-csd

debug {
    honor-xdg-activation-with-invalid-serial
}

// Noctalia stationary wallpaper: keep the regular wallpaper visible behind
// all workspaces. In Noctalia settings, leave overview wallpaper disabled.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// blur + noise
window-rule {
    background-effect {
        // blur true
        xray false
    }
}


// blur {
//     passes 1
//     offset 3.5
//     noise 0.12
//     saturation 0.6
// }
blur {
    //passes 2
    passes 2
    offset 0.75
    noise 0.0
    //noise 0.08
    //saturation 0.1
}

layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    background-effect { xray false; }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

// Lift the active window off the backdrop: bigger, darker shadow than the
// layout default.
window-rule {
    match is-active=true
    shadow {
        on
        softness 15
        spread 10
        offset x=2 y=10
        color "#000000b0"
    }
}

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match app-id="^text-input$"
    open-floating true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="^peek$"
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Ctrl+Space repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Super+S repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Super+Alt+Comma repeat=false { spawn "noctalia" "msg" "settings-toggle"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }

    Super+Return hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    // Borrows niri's trailing empty workspace and slides it up to current+1 — see the script.
    Super+Shift+Return hotkey-overlay-title="Open Terminal in a New Workspace Below" { spawn-sh "~/.config/niri/scripts/spawn-in-new-workspace kitty"; }
    Super+E hotkey-overlay-title="Open File Manager" { spawn "kitty" "yazi"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" { spawn "swaylock"; }
    Super+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Super+Shift+E { quit; }
    Super+Shift+C { spawn "niri" "msg" "action" "load-config-file"; }

    Super+F { maximize-column; }
    Super+Shift+F { fullscreen-window; }
    Super+Shift+Space { toggle-window-floating; }
    Super+V { toggle-window-floating; }
    Super+Shift+V { switch-focus-between-floating-and-tiling; }

    Super+H { focus-column-left; }
    Super+J { focus-window-down; }
    Super+K { focus-window-up; }
    Super+L { focus-column-right; }
    Super+Left { focus-column-left; }
    Super+Down { focus-window-down; }
    Super+Up { focus-window-up; }
    Super+Right { focus-column-right; }

    Super+Shift+H { move-column-left; }
    Super+Shift+L { move-column-right; }
    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }

    Super+Shift+Down { move-window-down; }
    Super+Shift+Up { move-window-up; }
    Super+Shift+J { move-window-down; }
    Super+Shift+K { move-window-up; }

    Super+Home { focus-column-first; }
    Super+End { focus-column-last; }
    Super+Ctrl+Home { move-column-to-first; }
    Super+Ctrl+End { move-column-to-last; }

    Super+Page_Down { focus-window-down; }
    Super+Page_Up { focus-window-up; }
    Alt+J { focus-workspace-down; }
    Alt+K { focus-workspace-up; }
    Alt+Page_Down { focus-workspace-down; }
    Alt+Page_Up { focus-workspace-up; }
    Super+Shift+Page_Down { move-column-to-workspace-down; }
    Super+Shift+Page_Up { move-column-to-workspace-up; }
    Alt+Shift+J { move-workspace-down; }
    Alt+Shift+K { move-workspace-up; }
    Alt+Shift+Page_Down { move-workspace-down; }
    Alt+Shift+Page_Up { move-workspace-up; }

    // take in, push out
    Super+Comma { consume-window-into-column; }
    Super+Period { expel-window-from-column; }

    // take in, take in
    Super+BracketLeft { consume-or-expel-window-left; }
    Super+BracketRight { consume-or-expel-window-right; }

    Super+R { switch-preset-column-width; }
    Super+Shift+R { switch-preset-column-width-back; }
    Super+Ctrl+Shift+R { switch-preset-window-height; }
    Super+Ctrl+R { reset-window-height; }
    Super+M { maximize-window-to-edges; }
    Super+Ctrl+F { expand-column-to-available-width; }
    Super+C { center-column; }
    Super+Ctrl+C { center-visible-columns; }
    Super+Minus { set-column-width "-10%"; }
    Super+Equal { set-column-width "+10%"; }
    Super+Shift+Minus { set-window-height "-10%"; }
    Super+Shift+Equal { set-window-height "+10%"; }
    Super+W { toggle-column-tabbed-display; }

    F6 { screenshot-screen; }
    Super+F6 { screenshot; }
    Alt+Print { screenshot-window; }
    Super+N { spawn-sh "wali"; }

    Super+1 { focus-workspace 1; }
    Super+2 { focus-workspace 2; }
    Super+3 { focus-workspace 3; }
    Super+4 { focus-workspace 4; }
    Super+5 { focus-workspace 5; }
    Super+6 { focus-workspace 6; }
    Super+7 { focus-workspace 7; }
    Super+8 { focus-workspace 8; }
    Super+9 { focus-workspace 9; }
    Super+0 { focus-workspace 10; }

    Super+Shift+1 { move-column-to-workspace 1; }
    Super+Shift+2 { move-column-to-workspace 2; }
    Super+Shift+3 { move-column-to-workspace 3; }
    Super+Shift+4 { move-column-to-workspace 4; }
    Super+Shift+5 { move-column-to-workspace 5; }
    Super+Shift+6 { move-column-to-workspace 6; }
    Super+Shift+7 { move-column-to-workspace 7; }
    Super+Shift+8 { move-column-to-workspace 8; }
    Super+Shift+9 { move-column-to-workspace 9; }
    Super+Shift+0 { move-column-to-workspace 10; }

    Alt+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Alt+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Alt+Shift+WheelScrollDown cooldown-ms=150 { move-workspace-down; }
    Alt+Shift+WheelScrollUp cooldown-ms=150 { move-workspace-up; }

    Super+WheelScrollRight { focus-column-right; }
    Super+WheelScrollLeft { focus-column-left; }

    Super+O repeat=false { toggle-overview; }
    Super+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Super+Shift+P { power-off-monitors; }
}
